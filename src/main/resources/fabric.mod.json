{
	"schemaVersion": 1,
	"id": "guildy",
	"version": "${version}",
	"name": "Guildy",
	"description": "Server-side PvE guild survival: guilds, chunk territories with flags, nightly hordes and events, quests, shop and travelling merchants, working villagers, a tech tree and unique weapons. Vanilla clients supported.",
	"authors": [
		"nightFury"
	],
	"contact": {
		"homepage": "https://github.com/softpython2884/Guildy",
		"sources": "https://github.com/softpython2884/Guildy",
		"issues": "https://github.com/softpython2884/Guildy/issues"
	},
	"license": "MIT",
	"environment": "server",
	"entrypoints": {
		"main": [
			"dev.guildy.Guildy"
		]
	},
	"mixins": [
		"guildy.mixins.json",
		"guildy.quest.mixins.json",
		"guildy.wave.mixins.json",
		"guildy.scroll.mixins.json",
		"guildy.ruin.mixins.json",
		"guildy.unique.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"polymer-resource-pack": "*",
		"polymer-autohost": "*"
	}
}
