{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "guildy:item/egide_des_ames"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": {
        "type": "minecraft:model",
        "model": "guildy:item/egide_des_ames_in_hand"
      },
      "on_true": {
        "type": "minecraft:model",
        "model": "guildy:item/egide_des_ames_in_hand_blocking"
      }
    }
  }
}
