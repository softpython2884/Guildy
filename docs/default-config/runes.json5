	// Reglages des pouvoirs des runes (jamais contre les joueurs, villageois ou animaux : monstres seulement)
	"powers": {

		// Etincelles : un monstre qui frappe au corps a corps prend une gerbe d'etincelles
		"sparks": {

			// Degats des etincelles (points de vie, 2 = 1 coeur)
			"damage": 2.0,

			// Recharge (secondes)
			"cooldownSeconds": 3.0
		},

		// Braise : un monstre qui vous frappe peut prendre feu
		"ember": {

			// Chance (0 a 1) d'enflammer le monstre
			"chance": 0.35,

			// Duree du feu (secondes)
			"fireSeconds": 4,

			// Recharge (secondes)
			"cooldownSeconds": 4.0
		},

		// Lueur : quand vous etes frappe, les monstres autour brillent quelques secondes
		"glow": {

			// Rayon (blocs) autour du porteur
			"radius": 12.0,

			// Duree de la lueur (secondes)
			"seconds": 6,

			// Recharge (secondes)
			"cooldownSeconds": 15.0
		},

		// Echo : rester accroupi immobile envoie une onde qui revele les monstres autour
		"echo": {

			// Temps accroupi immobile avant l'onde (secondes)
			"sneakSeconds": 2.0,

			// Rayon de l'onde (blocs)
			"radius": 24.0,

			// Duree de la lueur des monstres reveles (secondes)
			"seconds": 4,

			// Recharge (secondes)
			"cooldownSeconds": 20.0
		},

		// Renard : les objets au sol tout proches volent vers vous (pas accroupi)
		"fox": {

			// Rayon d'attraction des objets (blocs)
			"radius": 5.0,

			// Objets attires au plus a chaque impulsion (deux par seconde)
			"maxItems": 12
		},

		// Rebond : apres une grande chute, vous rebondissez (la rune reduit aussi les degats de chute)
		"bounce": {

			// Hauteur de chute minimum (blocs) pour rebondir
			"minFall": 4.0,

			// Force du rebond (vitesse verticale ; 0.42 = un saut)
			"hop": 0.5,

			// Recharge (secondes)
			"cooldownSeconds": 1.0
		},

		// Phenix (mythique) : un coup mortel vous releve de vos cendres dans une explosion de flammes
		"phoenix": {

			// Recharge (minutes de jeu ; elle suit le plastron et survit aux redemarrages)
			"cooldownMinutes": 20,

			// Vie rendue (part de la vie maximum, 0.5 = la moitie)
			"healthRatio": 0.5,

			// Rayon de l'explosion de flammes (blocs)
			"radius": 6.0,

			// Degats de feu aux monstres du rayon
			"damage": 6.0,

			// Les monstres du rayon brulent (secondes)
			"fireSeconds": 6,

			// Force de projection des monstres
			"push": 1.2,

			// Resistance au feu donnee au porteur (secondes)
			"fireResistanceSeconds": 15,

			// Regeneration donnee au porteur (secondes, niveau)
			"regenSeconds": 8,
			"regenLevel": 2
		},

		// Dragon (mythique) : le plastron plane comme des elytres ; accroupi + saut = souffle du dragon
		"dragon": {

			// Le plastron plane comme des elytres (sauter en l'air ; il s'use en planant, le forgeron le repare)
			"glide": true,

			// Recharge du souffle (secondes)
			"breathCooldownSeconds": 20.0,

			// Portee du souffle (blocs)
			"breathRange": 9.0,

			// Demi-angle du cone du souffle (degres)
			"breathAngle": 40.0,

			// Degats du souffle aux monstres du cone
			"breathDamage": 6.0,

			// Les monstres touches brulent (secondes)
			"breathFireSeconds": 4
		}
	}
}
