// Guildy - quetes de guilde (tableau de quetes : 6 panneaux = 6 quetes communes a toute la guilde).
// Types : GATHER (casser des blocs : target = bloc ou #tag), KILL (tuer : target = entite ou #tag),
// DELIVER (livrer depuis le menu : target = objet ou #tag), SURVIVE (gagner des vagues nocturnes),
// EXPLORE (atteindre un lieu tire au hasard loin du coeur).
// Valeurs a l'echelle du niveau de guilde : valeur = aleatoire(min..max) + perLevel x (niveau - 1).
// rewardItems : [{item, count, chance (0..1)}] ; flagChance / treasureMapChance : chance (0..1) d'obtenir
// un drapeau d'extension / une carte au tresor. durationDays : duree en jours de jeu (1 jour = 20 minutes).
// weight : poids relatif du tirage ; minLevel / maxLevel (0 = sans maximum) : niveaux de guilde concernes.
{

	// Delai (secondes) avant qu'une nouvelle quete apparaisse sur un panneau libere
	"refreshDelaySeconds": 120,

	// Annoncer aux membres connectes chaque nouvelle quete affichee au tableau
	"announceNewQuests": true,

	// Quetes EXPLORE : distance minimale / maximale (blocs) entre le coeur de la guilde et le lieu a atteindre
	"exploreMinDistance": 300,
	"exploreMaxDistance": 800,

	// Quetes EXPLORE : un membre doit passer a moins de ce nombre de blocs du lieu
	"exploreRadius": 24,

	// Cartes au tresor (recompenses de quetes)
	"treasure": {

		// Distance minimale / maximale (blocs) entre le coeur de la guilde et le tresor
		"minDistance": 150,
		"maxDistance": 450,

		// Distance horizontale (blocs) a laquelle le tresor est deterre (carte en main)
		"digRadius": 4,

		// En dessous de cette distance (blocs), la distance restante s'affiche (carte en main)
		"hintRadius": 64,

		// Rangs de tresor (le premier element = rang 1). Rang = 1 + (niveau de guilde - 1) / 3.
		// lootTable : table de butin vanilla du coffre ; goldMin / goldMax : lingots d'or ajoutes ;
		// items : objets bonus [{item, count, chance}]
		"tiers": [
			{
				"lootTable": "minecraft:chests/simple_dungeon",
				"goldMin": 4,
				"goldMax": 8,
				"items": [
					{
						"item": "minecraft:emerald",
						"count": 2,
						"chance": 0.5
					}
				]
			},
			{
				"lootTable": "minecraft:chests/buried_treasure",
				"goldMin": 8,
				"goldMax": 16,
				"items": [
					{
						"item": "minecraft:diamond",
						"count": 1,
						"chance": 0.5
					}
				]
			},
			{
				"lootTable": "minecraft:chests/woodland_mansion",
				"goldMin": 16,
				"goldMax": 28,
				"items": [
					{
						"item": "minecraft:diamond",
						"count": 2,
						"chance": 0.6
					},
					{
						"item": "minecraft:experience_bottle",
						"count": 8,
						"chance": 0.5
					}
				]
			}
		]
	},

