// Guildy - ruines : des ruines generees dans l'Overworld et le Nether, chacune gardee par un boss.
// Le boss dort jusqu'a la lecture d'un parchemin d'incantation pres de son point d'apparition (rituel qui draine le sang
// des joueurs presents, voir 'summon') ; vaincu, il revient apres 'respawnDays' jours.
// Le villageois Cartographe (construction 'Atelier du cartographe') localise les ruines : carte (Overworld) ou
// boussole (Nether). Commandes admin : /guild admin ruin list | info | awaken | reset | locate <id> | map <joueur> <id>
// | incantation <joueur> [nombre] | threat <niveau> (menace de la ruine la plus proche) | guards [clear] (gardiens de salle)
// | statues <joueur> | statues list (chemin de statues du grand temple, voir cartography.statues).
// Les parchemins d'incantation se donnent aussi avec /guild admin scroll give <joueur> incantation|incantation_maudit [nombre].
{

	// Version du fichier (geree automatiquement, ne pas modifier)
	"configVersion": 2,

	// Boss des ruines actifs (false = plus aucun boss ne se reveille ; les cartes restent possibles)
	"bossesEnabled": true,

	// Reglages communs des combats
	"encounter": {

		// Marge (blocs) autour de la boite de la ruine dans laquelle un joueur compte comme 'dans la ruine'
		"activationMargin": 2,

		// Marge (blocs) autour de la ruine ou les joueurs entretiennent le combat et voient la barre du boss
		"presenceMargin": 24,

		// Combats simultanes au maximum sur le serveur
		"maxActive": 8,

		// Delai (secondes) avant la premiere capacite du boss apres son reveil
		"firstAbilitySeconds": 4,

		// Delai minimal (secondes) entre deux capacites du boss
		"abilityGlobalCooldownSeconds": 3,

		// Portee (blocs) des capacites : seuls les joueurs plus proches sont vises
		"abilityRange": 24,

		// Assombrir le ciel des joueurs qui voient la barre du boss
		"darkenSky": true,

		// Annonce a tout le serveur quand un boss de ruine est vaincu
		"announce": true,

		// XP de guilde minimale par guilde participante (la recompense 'xp' est partagee selon le nombre de participants)
		"minXpPerGuild": 10
	},

	// Reveil des boss : parchemin d'incantation et rituel
	"summon": {

		// Reveil des boss : "scroll" (il faut lire un parchemin d'incantation pres du point d'apparition du boss ; entrer
		// dans la ruine ne le reveille plus) ou "proximity" (ancien comportement : un joueur en survie qui approche le reveille)
		"mode": "scroll",

		// Objet vanilla de base du parchemin d'incantation (son apparence sans pack de ressources)
		"item": "minecraft:skull_banner_pattern",

		// Taille maximale d'une pile de parchemins d'incantation (1 a 64)
		"maxStack": 16,

		// Duree (secondes) du clic droit maintenu avant le debut du rituel (0.25 a 10)
		"channelSeconds": 1.5,

		// Distance maximale (blocs) au point d'apparition du boss pour lancer le rituel ; tous les joueurs a cette
		// distance y participent (et sont draines)
		"arenaRadius": 16,

		// Duree (secondes) du rituel avant l'apparition du boss (2 a 30)
		"ritualSeconds": 7.0,

		// Points de vie draines a chaque participant pendant le rituel (2 = un coeur, 0 = aucun)
		"drainHealth": 4.0,

		// Le drain ne fait jamais descendre un participant sous ces points de vie (1 au minimum : le rituel ne tue jamais)
		"minHealth": 4.0,

		// Ralentir les participants pendant le drain
		"slowParticipants": true,

		// Particules envoyees au maximum par tick pour tous les rituels (au-dela, l'animation est allegee)
		"particleBudget": 900,

		// Distance (blocs) a laquelle les joueurs voient le rituel (particules longue distance)
		"viewDistance": 128,

		// Incantation scellee (des gardiens de salle tiennent encore l'arene) : duree (secondes, 0.5 a 5) pendant laquelle le
		// cercle d'incantation se dessine sous le lecteur avant de se briser. Le parchemin n'est jamais consomme
		"sealSeconds": 1.5,

		// Delai (secondes, 1 a 30) avant qu'un joueur puisse relancer une incantation scellee (anti-spam, compte des le debut)
		"sealCooldownSeconds": 3.0,

		// Palier minimal du Carrefour commercial dont le marchand propose parfois un parchemin d'incantation (0 = jamais)
		"tradeTier": 2,

		// Chance (0 a 1) que le marchand du Carrefour propose un parchemin d'incantation
		"tradeChance": 0.5,

		// Prix (lingots d'or) d'un parchemin d'incantation chez le marchand du Carrefour
		"tradePrice": 24
	},

	// Menace (niveaux I, II, III... propres a chaque ruine) : chaque victoire sur un gardien eleve la menace de sa ruine ;
	// a son retour (respawnDays), le gardien est plus fort (vie, degats, armure, escorte, recharges, rage) et rapporte plus
	"escalation": {

		// Menace active (false = tous les gardiens restent au niveau I ; les niveaux deja atteints sont conserves)
		"enabled": true,

		// Niveau de menace maximal d'une ruine (1 a 50)
		"maxLevel": 10,

		// Vie du gardien en plus par niveau au-dela de I (0.2 = +20 %)
		"healthPerLevel": 0.2,

		// Degats du gardien (attaque et capacites) en plus par niveau au-dela de I (0.1 = +10 %)
		"damagePerLevel": 0.1,

		// Points d'armure du gardien en plus par niveau au-dela de I (armure vanilla plafonnee a 30)
		"armorPerLevel": 1.0,

		// Un sbire de plus (escorte et plafond des invocations) tous les N niveaux (0 = jamais)
		"minionsEveryLevels": 2,

		// Recharges des capacites reduites par niveau au-dela de I (0.05 = -5 %)
		"cooldownPerLevel": 0.05,

		// Facteur minimal des recharges dues a la menace (0.6 = jamais plus de -40 %)
		"minCooldownFactor": 0.6,

		// Seuil de rage (ratio de vie) releve par niveau au-dela de I : la rage arrive plus tot
		"enragePerLevel": 0.02,

		// Seuil de rage maximal atteint par la menace (0 a 1)
		"maxEnrageThreshold": 0.5,

		// Or du butin en plus par niveau au-dela de I (0.15 = +15 %)
		"goldPerLevel": 0.15,

		// XP de guilde en plus par niveau au-dela de I (0.15 = +15 %)
		"xpPerLevel": 0.15,

		// Chance d'un tirage d'arme unique supplementaire par niveau au-dela de I (0.05 = 5 % par niveau, 100 % au plus)
		"uniqueChancePerLevel": 0.05,

		// Chance d'un tirage de parchemin de sort supplementaire par niveau au-dela de I
		"scrollChancePerLevel": 0.08
	},

	// Resurrection : un gardien abattu trop vite (moins de fastKillSeconds apres son apparition) refuse de mourir. Il
	// revient d'entre les morts une seule fois par combat, enrage ; le vaincre sous cette forme donne un butin bonus
	"resurrection": {

		// Resurrection des gardiens abattus trop vite
		"enabled": true,

		// Fenetre (secondes apres l'apparition du gardien) pendant laquelle sa mort declenche la resurrection :
		// fastKillSeconds + fastKillPerTier par palier au-dela de 1 + fastKillPerThreat par niveau de menace au-dela de I
		// (une ruine peut fixer la sienne : 'fastKillSeconds' de sa definition)
		"fastKillSeconds": 45.0,
		"fastKillPerTier": 15.0,
		"fastKillPerThreat": 5.0,

		// Duree (secondes) de l'animation de resurrection, pendant laquelle le gardien est invulnerable et immobile (2 a 15)
		"durationSeconds": 5.0,

		// Part de la vie maximale rendue au gardien ressuscite (0.1 a 1)
		"healthRatio": 1.0,

		// Taille du gardien ressuscite (multiplicateur, 1 a 2 ; limitee par la hauteur libre au-dessus de lui)
		"scale": 1.25,

		// Vitesse de deplacement en plus du gardien ressuscite (0.25 = +25 %)
		"speedBonus": 0.25,

		// Degats en plus du gardien ressuscite (attaque et capacites, 0.4 = +40 %)
		"damageBonus": 0.4,

		// Facteur des recharges de ses capacites une fois ressuscite (0.7 = -30 %, en plus de la rage)
		"cooldownFactor": 0.7,

		// Sbires invoques a son retour (dans la limite de l'escorte vivante)
		"minions": 4,

		// Rayon (blocs) de l'onde de choc de son retour : repousse les joueurs, sans degats (0 = aucune)
		"shockwaveRadius": 8.0,

		// Force de la poussee de l'onde de choc (0 a 4)
		"shockwaveStrength": 1.2,

		// Particules envoyees au maximum par tick pour l'animation d'une resurrection (100 a 5000)
		"particleBudget": 700,

		// Tirages en plus dans la table de butin quand le gardien est vaincu sous sa forme ressuscitee
		"bonusLootRolls": 2,

		// Or du butin en plus sous la forme ressuscitee (0.5 = +50 %)
		"bonusGold": 0.5,

		// XP de guilde en plus sous la forme ressuscitee (0.5 = +50 %)
		"bonusXp": 0.5,

		// Tirages d'arme unique en plus sous la forme ressuscitee
		"bonusUniqueRolls": 1,

		// Tirages de parchemin de sort en plus sous la forme ressuscitee
		"bonusScrollRolls": 1
	},

	// Gardiens de salle : quand un joueur en survie / aventure approche d'une ruine dormante, des ennemis apparaissent a leurs
	// postes (marqueurs guildy:guard, sinon pres des sbires, de l'entree et autour du gardien endormi). Une fois par periode
	// dormante : tues, ils ne reviennent qu'apres le depart de tous les joueurs (resetSeconds de la ruine)
	"guards": {

		// Gardiens de salle actifs
		"enabled": true,

		// Marge (blocs) autour de la boite de la ruine : un joueur en survie / aventure qui y entre fait apparaitre les gardiens
		"triggerMargin": 8,

		// Gardiens par palier de ruine (palier 1, 2, 3, 4, 5)
		"countByTier": [
			2,
			3,
			4,
			5,
			6
		],

		// Gardiens en plus par joueur en survie / aventure present au-dela du premier
		"perExtraPlayer": 1,

		// Un gardien de plus tous les N niveaux de menace (0 = jamais)
		"threatLevelsPerGuard": 2,

		// Gardiens au maximum par ruine
		"max": 12,

		// Distance (blocs) a leur poste au-dela de laquelle les gardiens y retournent (au double : ramenes d'un coup)
		"leashRadius": 10,

		// Tant que des gardiens vivent dans l'arene (rayon 'summon.arenaRadius' autour du gardien endormi), l'incantation est
		// refusee (en mode proximity, le gardien ne se reveille pas)
		"blockRitual": true,

		// Message a l'ecran (barre d'action) quand les gardiens prennent leur poste. false = aucun : seuls un bruit sourd et
		// l'indice du chat a l'entree de la ruine trahissent leur presence (sans les compter)
		"announceOnScreen": false,

		// Ruines sans marqueur guildy:guard : rayon (blocs) du cercle de postes de secours autour du gardien endormi
		"fallbackRadius": 7,

		// Ruines sans marqueur guildy:guard : postes de secours sur ce cercle (en plus des sbires et de l'entree)
		"fallbackPoints": 6
	},

	// Renfort selon le groupe : plus il y a de joueurs en survie / aventure a l'apparition du gardien (arene ou ruine), plus il
	// est fort et plus il rapporte. Se multiplie avec la menace (ex. menace III +40 % de vie et 3 joueurs +100 % : x2.8)
	"scaling": {

		// Renfort selon le nombre de joueurs presents
		"enabled": true,

		// Joueurs comptes au maximum (1 a 32)
		"maxPlayers": 8,

		// Vie du gardien en plus par joueur au-dela du premier (0.5 = +50 %)
		"healthPerPlayer": 0.5,

		// Degats du gardien (attaque et capacites) en plus par joueur au-dela du premier (0.15 = +15 %)
		"damagePerPlayer": 0.15,

		// Sbires en plus par joueur au-dela du premier (escorte et plafond des invocations, arrondi a l'inferieur)
		"minionsPerPlayer": 0.5,

		// Or du butin en plus par joueur au-dela du premier (0.5 = +50 %)
		"goldPerPlayer": 0.5,

		// XP de guilde en plus par joueur au-dela du premier (0.5 = +50 %)
		"xpPerPlayer": 0.5,

		// L'or du gardien est partage entre les participants : chacun recoit sa part, que lui seul peut ramasser
		"shareGold": true
	},

	// Gardiens maudits : le parchemin d'incantation maudit eveille le gardien d'une ruine dormante sous une forme maudite
	// (bien plus forte, trois phases, attaques folles, recompenses enormes). Admin : /guild admin ruin incantation <joueur>
	// [nombre] cursed | awaken cursed | cursed phase | cursed attack <attaque>
	"cursed": {

		// Gardiens maudits actifs (false = le parchemin d'incantation maudit est refuse, il n'apparait plus a la vente)
		"enabled": true,

		// Le parchemin d'incantation maudit et son rituel
		"ritual": {

			// Objet vanilla de base du parchemin maudit (son apparence sans pack de ressources)
			"item": "minecraft:piglin_banner_pattern",

			// Taille maximale d'une pile de parchemins maudits (1 a 64)
			"maxStack": 4,

			// Duree (secondes) du clic droit maintenu avant le debut du rituel maudit (0.25 a 10)
			"channelSeconds": 2.5,

			// Duree (secondes) du rituel maudit avant l'apparition du gardien (2 a 30)
			"ritualSeconds": 10.0,

			// Points de vie draines a chaque participant pendant le rituel maudit (6 = trois coeurs, 0 = aucun)
			"drainHealth": 6.0,

			// Le drain ne fait jamais descendre un participant sous ces points de vie (1 au minimum)
			"minHealth": 4.0
		},

		// Le gardien maudit : le gardien de la ruine, nomme "Maudit", barre violette. Ces multiplicateurs s'ajoutent a ceux
		// de la menace (et de la taille du groupe) : vie = vie de la ruine x menace x healthMultiplier
		"guardian": {

			// Vie du gardien maudit (multiplicateur, 1 a 20)
			"healthMultiplier": 3.0,

			// Degats du gardien maudit : attaque et capacites (multiplicateur, 1 a 10)
			"damageMultiplier": 2.0,

			// Points d'armure en plus (armure vanilla plafonnee a 30)
			"armorBonus": 8.0,

			// Robustesse d'armure en plus
			"toughnessBonus": 4.0,

			// Taille du gardien maudit (multiplicateur, 1 a 2 ; limitee par la hauteur libre de l'arene)
			"scale": 1.3,

			// Vitesse de deplacement en plus (0.15 = +15 %)
			"speedBonus": 0.15,

			// Resistance au recul minimale du gardien maudit (0 a 1)
			"knockbackResistance": 0.9,

			// Recharges de ses capacites normales (facteur, 0.6 = -40 % ; en plus de la menace et de la rage)
			"cooldownFactor": 0.6,

			// Escorte maudite : nombre de sbires multiplie par escortMultiplier, plus escortBonus
			"escortMultiplier": 1.5,
			"escortBonus": 2,

			// Sbires vivants en plus au maximum (plafond de l'escorte)
			"extraAlive": 6,

			// Vie et degats des sbires maudits (multiplicateurs, en plus de ceux de la ruine)
			"minionHealthMultiplier": 1.5,
			"minionDamageMultiplier": 1.3
		},

		// Les trois phases : sous phase2Below puis phase3Below (part de la vie), une transition ou il est invulnerable
		"phases": {

			// Part de la vie sous laquelle commence la phase 2 (0.66 = 66 %)
			"phase2Below": 0.66,

			// Part de la vie sous laquelle commence la phase 3 (inferieure a phase2Below)
			"phase3Below": 0.33,

			// Duree (secondes) d'une transition de phase (2 a 10) : le gardien est invulnerable et s'eleve, un pentagramme geant
			// s'embrase, des chaines d'ames lient les joueurs, une onde de choc les repousse (sans degats), des sbires surgissent
			"transitionSeconds": 4.0,

			// Degats en plus a chaque phase au-dela de la premiere (0.25 = +25 % en phase 2, +50 % en phase 3)
			"damageBonus": 0.25,

			// Recharges multipliees a chaque phase au-dela de la premiere (0.85 = -15 % par phase)
			"cooldownFactor": 0.85,

			// Vitesse en plus a chaque phase au-dela de la premiere (0.1 = +10 %)
			"speedBonus": 0.1,

			// Sbires qui surgissent du sol a chaque transition (dans la limite de l'escorte vivante)
			"minions": 3,

			// Rayon (blocs) et force de l'onde de choc d'une transition (repousse les joueurs, sans degats)
			"shockwaveRadius": 9.0,
			"shockwaveStrength": 1.4,

			// Duree (secondes) de l'effet Obscurite donne aux joueurs quand l'arene s'assombrit (0 = aucun)
			"darknessSeconds": 4.0
		},

		// Attaques maudites (en plus de ses capacites normales) : phase 2 = pentagrammes (drainent la vie des joueurs qui
		// restent dedans et soignent le gardien), chaines d'ames (attirent un joueur), meteores noirs ; phase 3 = en plus
		// ondes de tenebres (effet Obscurite), cages de foudre (foudre visuelle, degats si on reste dans le cercle), nova de
		// sang (draine tous les joueurs proches), ombres (copies faibles et temporaires), aura maudite permanente.
		// Chaque attaque est annoncee (cercle d'alerte) avant de frapper. Recharges en secondes, degats en points de vie
		"attacks": {

			// Delai minimal (secondes) entre deux attaques maudites
			"globalCooldownSeconds": 3.0,

			// Pentagrammes (phase 2) : recharge, nombre (+1 en phase 3), rayon, duree, degats par pulsation (toutes les 0,5 s)
			"pentagramCooldownSeconds": 15.0,
			"pentagramCount": 3,
			"pentagramRadius": 2.5,
			"pentagramSeconds": 8.0,
			"pentagramDamage": 1.5,

			// Le gardien se soigne de pentagramHeal fois la vie drainee par les pentagrammes
			"pentagramHeal": 2.0,

			// Chaines d'ames (phase 2) : recharge, joueurs vises, force de l'attraction (0 a 2), degats quand elles se brisent
			"chainCooldownSeconds": 12.0,
			"chainTargets": 2,
			"chainPull": 0.9,
			"chainDamage": 4.0,

			// Meteores noirs (phase 2) : recharge, nombre, degats au centre, rayon de l'impact
			"meteorCooldownSeconds": 14.0,
			"meteorCount": 6,
			"meteorDamage": 8.0,
			"meteorRadius": 2.5,

			// Ondes de tenebres (phase 3) : recharge, duree de l'Obscurite (secondes), degats
			"darknessCooldownSeconds": 18.0,
			"darknessSeconds": 6.0,
			"darknessDamage": 2.0,

			// Cages de foudre (phase 3) : recharge, joueurs vises, rayon, duree (secondes), degats par pulsation si on reste dedans
			"cageCooldownSeconds": 15.0,
			"cageTargets": 2,
			"cageRadius": 2.5,
			"cageSeconds": 3.0,
			"cageDamage": 3.0,

			// Nova de sang (phase 3) : recharge, rayon, degats, soin du gardien (fois la vie drainee)
			"novaCooldownSeconds": 22.0,
			"novaRadius": 14.0,
			"novaDamage": 6.0,
			"novaHeal": 1.5,

			// Ombres (phase 3) : recharge, nombre, duree de vie (secondes), vie, part des degats du gardien
			"cloneCooldownSeconds": 25.0,
			"cloneCount": 2,
			"cloneSeconds": 20.0,
			"cloneHealth": 30.0,
			"cloneDamageRatio": 0.4,

			// Aura maudite (phase 3) : rayon (blocs) et duree (secondes) de l'effet Wither donne aux joueurs trop proches (0 = aucun)
			"auraRadius": 3.5,
			"auraWitherSeconds": 2.0,

			// Particules envoyees au maximum par tick pour tous les rituels et combats maudits (au-dela, l'animation est allegee)
			"particleBudget": 1200
		},

		// Forme finale : abattu a la fin de la phase 3, le gardien maudit se releve toujours une derniere fois, enrage (meme
		// animation que la resurrection, aux couleurs de la malediction ; taille, vitesse, degats, sbires et onde de choc de
		// 'resurrection'), quelle que soit la duree du combat. Les recompenses maudites tombent a sa mort definitive
		"finalForm": {

			// Le gardien maudit se releve une derniere fois a la fin de la phase 3 (false = il meurt a la fin de la phase 3)
			"enabled": true,

			// Part de sa vie maximale rendue a la forme finale (0.1 a 1)
			"healthRatio": 0.5,

			// Ajouter aussi le bonus de butin d'un gardien ressuscite (section 'resurrection' : or, XP, tirages en plus). false par
			// defaut : la forme finale fait partie du combat maudit, ses recompenses sont deja celles de la malediction
			"risenRewards": false
		},

		// Recompenses d'une victoire sur un gardien maudit (en plus des bonus de la menace)
		"rewards": {

			// Or et XP de guilde multiplies (en plus de la menace)
			"goldMultiplier": 3.0,
			"xpMultiplier": 3.0,

			// Tirages en plus dans la table de butin de la ruine
			"extraLootRolls": 4,

			// Tentatives d'arme unique en plus (chacune avec la chance de la source de la ruine dans uniques.json5, regles
			// d'unicite respectees) et nombre maximal d'armes uniques par victoire
			"extraUniqueRolls": 5,
			"maxUniques": 2,

			// Tirages de parchemin de sort en plus (chance de la source dans scrolls.json5)
			"extraScrollRolls": 3,

			// Au moins un parchemin de sort garanti (si aucun tirage n'en donne)
			"guaranteedScroll": true,

			// Chance (0 a 1) d'un grimoire vierge en plus
			"grimoireChance": 0.35,

			// Niveaux de menace gagnes par la ruine apres une victoire sur son gardien maudit (au lieu de 1)
			"threatGain": 2,

			// Annonce a tout le serveur ("La malediction est brisee...")
			"announce": true
		},

		// Ou trouver le parchemin maudit (en plus de la commande admin)
		"sources": {

			// Palier minimal du Carrefour commercial dont le marchand propose parfois le parchemin maudit (0 = jamais)
			"tradeTier": 3,

			// Chance (0 a 1) que le marchand du Carrefour le propose a une visite
			"tradeChance": 0.25,

			// Prix (lingots d'or) du parchemin maudit chez le marchand du Carrefour
			"tradePrice": 250,

			// Chance (0 a 1) qu'un gardien vaincu sous sa forme ressuscitee (Enrage) laisse un parchemin maudit
			"risenChance": 0.15,

			// Chance (0 a 1) qu'un contrat legendaire termine donne un parchemin maudit
			"legendaryQuestChance": 0.1
		}
	},

	// Bilan du combat : a la victoire (et en plus court sur un echec), chaque participant recoit dans le chat les titres du
	// combat (meilleurs degats au gardien, aux gardiens de salle, aux sbires, soins, absorption, degats encaisses, coup fatal)
	// et sa propre ligne, avec le detail par joueur (survol des noms, menu [Voir le detail], /guild bilan). Compte depuis
	// l'apparition des gardiens de salle ; projectiles, sorts et animaux comptent pour leur proprietaire ; creatif ignore
	"stats": {

		// Bilan du combat actif (false = rien n'est suivi ni envoye)
		"enabled": true,

		// Titres du chat, dans cet ordre : guardian (Fleau du gardien : degats au gardien), guards (Briseur de gardes : degats
		// aux gardiens de salle), escort (Chasseur de sbires : degats a l'escorte), healing (Ange gardien : soins donnes aux
		// autres joueurs), shield (Protecteur : absorption donnee), tank (Rempart : degats encaisses), final_blow (Coup fatal),
		// kills (Moissonneur : monstres tues), spells (Arcaniste : sorts lances). Le menu du detail montre toujours tout
		"categories": [
			"guardian",
			"guards",
			"escort",
			"healing",
			"shield",
			"tank",
			"final_blow"
		],

		// Points minimum (degats infliges, soins, absorption donnee ou degats encaisses) pour figurer dans le bilan (0 a 10000 ;
		// 0 = tous les joueurs passes dans l'arene). Les joueurs presents a la fin le recoivent quand meme
		"minDamage": 1.0,

		// Minutes pendant lesquelles chacun peut rouvrir son dernier bilan avec /guild bilan (1 a 1440)
		"keepMinutes": 30,

		// Bilan court aussi quand le combat echoue (combat reinitialise faute de joueurs, gardien disparu, admin reset)
		"onFailure": true,

		// Joueurs suivis au maximum par combat (2 a 64)
		"maxPlayers": 32
	},

	// Recherches de l'Atelier du cartographe
	"cartography": {

		// Minutes de travail d'un cartographe pour une recherche (plusieurs cartographes vont plus vite, pause la nuit)
		"researchMinutes": 8.0,

		// Cartographes qui comptent au maximum en meme temps (chacun ajoute une seconde de travail par seconde)
		"maxCartographers": 3,

		// Cout d'une recherche dans l'Overworld : objets pris dans l'inventaire du joueur {objet: nombre} (refuse en creatif)
		"overworldCost": {
			"minecraft:paper": 8,
			"minecraft:compass": 1
		},

		// Cout d'une recherche dans le Nether
		"netherCost": {
			"minecraft:paper": 8,
			"minecraft:compass": 1,
			"minecraft:quartz": 4
		},

		// Or du tresor de guilde ajoute au cout (0 = aucun ; permission Tresor requise sinon)
		"goldCost": 0,

		// Rayon de recherche (en cases de la grille de placement des ruines, comme les cartes d'explorateur vanilla)
		"searchRadius": 64,

		// Zoom des cartes (0 a 4, 2 = comme les cartes d'explorateur)
		"mapZoom": 2,

		// Icone de la cible sur les cartes (type de decoration vanilla, ex. minecraft:red_x, minecraft:target_x)
		"mapDecoration": "minecraft:red_x",

		// Parchemins d'incantation donnes avec chaque carte / boussole d'une recherche reussie (0 = aucun)
		"incantationsPerResearch": 1,

		// La legende du Jaguar celeste : le grand temple ne se trouve plus avec une carte ordinaire. Cette recherche donne une
		// carte des statues : des jaguars de pierre poses par le mod entre l'atelier et le temple, chacun tourne vers le
		// suivant ; qui s'approche d'une statue voit son regard montrer la suite du chemin. Admin : /guild admin ruin statues
		// <joueur> (carte des statues du grand temple le plus proche) | statues list
		"statues": {

			// Recherche 'La legende du Jaguar celeste' : elle localise le grand temple le plus proche et donne une carte des statues
			// de jaguar qui menent au temple. Le grand temple n'est alors plus propose par la recherche de surface normale
			// (false = plus de legende, le grand temple redevient une ruine de surface comme les autres pour les recherches)
			"enabled": true,

			// Structure du grand temple que la legende localise
			"templeStructure": "guildy:ruin/grand_temple_maya",

			// Gabarit des statues (pose par le mod au plus pres des points du chemin, face vers la statue suivante)
			"template": "guildy:ruin/statue_jaguar",

			// Couche du gabarit posee au niveau du sol (les couches en dessous sont des fondations enterrees)
			"groundLayer": 1,

			// Niveau de guilde minimal pour lancer la recherche de la legende
			"minGuildLevel": 7,

			// Cout de la recherche : objets pris dans l'inventaire du joueur {objet: nombre} (refuse en creatif)
			"cost": {
				"minecraft:paper": 16,
				"minecraft:compass": 1,
				"minecraft:emerald": 8
			},

			// Or du tresor de guilde ajoute au cout (0 = aucun ; permission Tresor requise sinon)
			"goldCost": 40,

			// Minutes de travail d'un cartographe pour la recherche de la legende
			"researchMinutes": 16.0,

			// Rayon de recherche du temple (en cases de la grille de placement du grand temple, comme searchRadius)
			"searchRadius": 64,

			// Nombre de statues du chemin (au minimum : davantage si l'ecart depasse maxSpacing, moins si le temple est proche)
			"count": 4,

			// Nombre maximal de statues d'un chemin
			"maxCount": 8,

			// Ecart minimal entre deux statues (blocs)
			"minSpacing": 64,

			// Ecart maximal entre deux statues (blocs, 0 = pas de limite : toujours 'count' statues)
			"maxSpacing": 800,

			// La derniere statue se dresse entre lastDistanceMin et lastDistanceMax blocs du temple (en vue de sa balise)
			"lastDistanceMin": 150,
			"lastDistanceMax": 250,

			// Decalage lateral maximal des statues (blocs, jamais la derniere) : le chemin n'est pas une ligne droite
			"lateralJitter": 32,

			// Rayon (blocs) autour du point prevu ou chercher un emplacement assez plat de blocs naturels, hors de l'eau et hors de
			// tout territoire de guilde (sinon une deuxieme recherche deux fois plus loin, puis la statue est abandonnee)
			"siteRadius": 20,

			// Denivele maximal (blocs) du sol sous la statue (les fondations comblent le reste)
			"maxSlope": 3,

			// Une statue existante a moins de ce rayon (blocs) d'un point prevu est reutilisee par le nouveau chemin
			"reuseRadius": 96,

			// Blocs naturels sur lesquels une statue peut etre posee (id ou #tag) : jamais sur une construction
			"groundBlocks": [
				"#minecraft:substrate_overworld",
				"#minecraft:base_stone_overworld",
				"#minecraft:sand",
				"#minecraft:terracotta",
				"minecraft:gravel",
				"minecraft:clay",
				"minecraft:sandstone",
				"minecraft:red_sandstone",
				"minecraft:calcite",
				"minecraft:snow_block",
				"minecraft:packed_ice"
			],

			// Bloc des fondations posees sous la statue jusqu'au sol
			"foundationBlock": "minecraft:mossy_cobblestone",

			// Statues protegees comme les sanctuaires (ni cassees, ni explosees, ni deplacees au piston)
			"protect": true,

			// Rayon (blocs) autour d'une statue : un joueur qui s'en approche voit son regard (particules, son) et recoit l'indice
			"guideRadius": 12,

			// Duree (secondes, 1 a 9) de la trainee de particules vers la statue suivante (ou le temple)
			"guideSeconds": 6.0,

			// Delai (secondes) avant qu'une statue guide de nouveau le meme joueur
			"guideCooldownSeconds": 45,

			// Longueur (blocs) de la trainee de particules
			"trailLength": 40,

			// Zoom des cartes des statues : le plus petit qui montre l'atelier et toutes les statues, entre mapMinZoom et mapMaxZoom (0 a 4)
			"mapMinZoom": 2,
			"mapMaxZoom": 4,

			// Icone des statues sur la carte (type de decoration vanilla)
			"mapDecoration": "minecraft:banner_lime",

			// Icone de la derniere statue (celle qui voit le temple)
			"lastMapDecoration": "minecraft:banner_yellow"
		}
	},

	// Boss generique des ruines inconnues de ce fichier (ajoutees par un autre pack de donnees)
	"generic": {

		// Palier du boss generique d'une ruine inconnue de l'Overworld (1 a 5)
		"overworldTier": 2,

		// Palier du boss generique d'une ruine inconnue du Nether (1 a 5)
		"netherTier": 4,

		// Gardiens de salle dans les ruines inconnues (false = aucun)
		"guards": true
	},

	// Ruines par id (le chemin du gabarit apres 'ruin/', ex. guildy:ruin/crypte_oubliee -> crypte_oubliee) :
	// name, tier (1 a 5), activationRadius (mode proximity : blocs autour du point d'apparition du boss pour le reveiller,
	// 0 = toute la ruine), resetSeconds (sans joueur proche pendant ce temps, le boss disparait et reviendra a pleine vie),
	// respawnDays (jours de jeu avant le retour d'un boss vaincu, 0 = jamais), leashRadius (au-dela, le boss est ramene a son
	// arene), bossBarColor (PINK, BLUE, RED, GREEN, YELLOW, PURPLE, WHITE ; aussi la couleur du rituel d'incantation),
	// mapDecoration (icone de la carte, vide = celle de 'cartography'), fastKillSeconds (resurrection : -1 = formule de
	// 'resurrection', 0 = ce gardien ne ressuscite jamais, sinon la fenetre en secondes).
	// boss : entity, name (codes couleur &), health, damage, armor, armorToughness, speed (0 = vitesse vanilla),
	// knockbackResistance (0 a 1), scale (taille, 1 = normale, 8 au plus), followRange, equipment {emplacement: objet} (mainhand,
	// offhand, head, chest, legs, feet), effects [{effect, amplifier}] (permanents), variant (variante vanilla d'un chat,
	// ex. minecraft:all_black ; vide = celle du jeu), cursedForm {entity, variant, name} (forme maudite : autre entite,
	// variante et nom ; vide = le meme gardien). Un ocelot ou un chat devient un fauve hostile qui chasse les joueurs.
	// minions (escorte) : types {entite: poids}, base + perExtraPlayer par joueur present au-dela du premier, max ;
	// maxAlive (plafond avec les invocations), healthMultiplier, damageMultiplier, equipment, effects.
	// abilities [{type, cooldownSeconds, damage, radius, count, style, healthBelow (0 a 1 : seulement sous ce ratio de vie),
	// amplifier}] : summon (invoque count sbires), ground_slam (onde de choc, style sand pour du sable), fire_ring (anneau :
	// style fire, soul, frost ou jade = poison et souffle), blink (se teleporte derriere un joueur et frappe ; style wind =
	// bourrasque), volley (salve : style arrow, spectral, fireball ou wind = lames de vent), life_drain (draine la vie des
	// joueurs proches), enrage (une fois sous healthBelow : Force + Vitesse de niveau amplifier, recharges reduites de moitie).
	// Capacites de fauve : pounce (bond sur un joueur, onde de choc de rayon radius a l'atterrissage), claw_sweep (coup de
	// griffes en arc devant lui, portee radius, count griffures), stalk (invisible et rapide, trahi par ses empreintes, puis
	// embuscade : degats damage a moins de radius blocs), roar (rugissement en cone de longueur radius : Lenteur de niveau
	// amplifier et Faiblesse), spirit_jaguars (count esprits jaguars temporaires, morsure damage, a moins de radius blocs) ;
	// styles gold (Lenteur), jade (Poison), solar (brule) ; violet et noir sous la forme maudite.
	// rewards : goldMin/goldMax (lingots), xp (XP de guilde partagee entre les guildes des participants), lootTable +
	// lootRolls (table de butin vanilla tiree au cadavre), items [{item, min, max, chance}], uniqueSource / scrollSource
	// (vide = ruin_boss dans l'Overworld, nether_ruin_boss dans le Nether ; sources de uniques.json5 et des parchemins).
	// guards (gardiens de salle) : count (-1 = 'guards.countByTier' du palier, 0 = aucun), name (nom affiche en les visant,
	// vide = aucun), types {entite: poids}, healthMultiplier, damageMultiplier, equipment, effects (types, equipment et
	// effects vides = ceux de l'escorte).
	"ruins": {
