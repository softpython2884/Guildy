// Guildy - evenements aleatoires : nuit de sang (tous les serveurs), raid de pillards, caravane marchande et erudit
// itinerant (par guilde). Tirages une fois par jour : au crepuscule pour les evenements de nuit, le matin pour ceux
// de jour. Chance = probabilite a chaque tirage ; cooldownDays = jours minimum entre deux occurrences pour une guilde.
// Admin : /guild admin event list | start <evenement> [guilde] | stop <evenement> [guilde]
// (blood_night, pillager_raid, caravan, book_merchant, merchant = visite du Carrefour commercial).
// Echanges (trades / books) : meme format que trade.json5 ; les marchands vendent seulement, jamais moins cher que la boutique.
{

	// Activer les tirages aleatoires (les commandes admin fonctionnent toujours)
	"randomEvents": true,

	// Heures des tirages (heure du jour en ticks : 0 = lever du soleil, 12000 = coucher, 13000 = debut des hordes)
	"timing": {

		// Tirage des evenements de nuit (nuit de sang) a partir de cette heure ; les raids en attente renoncent a cette heure
		"duskTime": 12000,

		// Tirage des evenements de jour (raid, caravane, erudit) a partir de cette heure
		"morningTime": 1000,

		// Duree (ticks) pendant laquelle un tirage peut encore avoir lieu apres l'heure prevue
		"rollWindowTicks": 1000
	},

	// Nuit de sang : au crepuscule, si une guilde a atteint minNightStep, chance de declencher une nuit ou TOUTES les
	// hordes sont plus nombreuses, plus fortes et paient davantage (barre de progression prefixee, annonce a tout le serveur).
	"bloodNight": {
		"enabled": true,

		// Chance chaque soir
		"chance": 0.07,

		// Il faut au moins une guilde ayant atteint ce palier de nuit
		"minNightStep": 3,

		// Nombre minimum de jours entre deux nuits de sang
		"minDaysBetween": 4,

		// Multiplicateur du nombre de monstres (toujours borne par maxMobsPerWave de waves.json5)
		"mobCountMultiplier": 1.6,

		// Chance d'elite ajoutee, puis plafonnee a eliteCap (jamais en dessous de la chance normale)
		"eliteBonus": 0.15,
		"eliteCap": 0.6,

		// Multiplicateurs de vie et de degats des monstres
		"healthMultiplier": 1.25,
		"damageMultiplier": 1.25,

		// Chance qu'un boss accompagne chaque horde
		"bossChance": 0.6,

		// Multiplicateurs des recompenses de victoire : or, XP de guilde, tirages d'objets
		"goldMultiplier": 2.0,
		"xpMultiplier": 2.0,
		"itemRollMultiplier": 1.5
	},

	// Raid de pillards : le matin, une guilde peut etre visee. Les membres sont prevenus des qu'un membre est pres du coeur,
	// puis une horde d'illageois attaque en plein jour (memes regles que les hordes : coeur, victoire, defaite).
	// Sans defenseur, les pillards attendent ; ils renoncent au crepuscule. Le palier de nuit ne change pas.
	"pillagerRaid": {
		"enabled": true,

		// Chance chaque matin, niveau de guilde minimum, jours minimum entre deux raids
		"chance": 0.05,
		"minGuildLevel": 2,
		"cooldownDays": 3,

		// Delai (secondes) entre l'alerte et l'attaque
		"warningSeconds": 120,

		// Duree maximale de l'assaut (secondes) : victoire si le coeur tient jusque-la (ou des que tous les pillards sont morts)
		"maxDurationSeconds": 600,

		// Multiplicateur des recompenses de victoire (or, XP de guilde, tirages d'objets)
		"rewardMultiplier": 1.2,

		// Composition de l'assaut (meme format qu'un theme de waves.json5 : name, barColor, mobCountMultiplier, eliteBonus,
		// forceBoss, mobs [{entity, weight, minDifficulty, maxCount, gear, alwaysHostile, spawnHeight}], bosses [...]).
		// La difficulte suit la formule des hordes (palier de nuit, niveau, membres presents).
		"theme": {
			"id": "pillager_raid",
			"name": "&6Raid de pillards",
			"weight": 1.0,
			"minNight": 0,
			"maxNight": -1,
			"barColor": "YELLOW",
			"eliteBonus": 0.0,
			"mobCountMultiplier": 0.8,
			"forceBoss": true,
			"bosses": [
				{
					"entity": "minecraft:ravager",
					"name": "&4&lRavageur des pillards",
					"weight": 10.0,
					"healthMultiplier": 2.5,
					"damageMultiplier": 1.0,
					"gear": false,
					"alwaysHostile": false,
					"spawnHeight": 0
				}
			],
			"mobs": [
				{
					"entity": "minecraft:pillager",
					"weight": 45.0,
					"minDifficulty": 0.0,
					"maxCount": 0,
					"gear": false,
					"alwaysHostile": false,
					"spawnHeight": 0
				},
				{
					"entity": "minecraft:vindicator",
					"weight": 30.0,
					"minDifficulty": 0.0,
					"maxCount": 0,
					"gear": false,
					"alwaysHostile": false,
					"spawnHeight": 0
				},
				{
					"entity": "minecraft:evoker",
					"weight": 4.0,
					"minDifficulty": 3.0,
					"maxCount": 1,
					"gear": false,
					"alwaysHostile": false,
					"spawnHeight": 0
				}
			]
		}
	},

