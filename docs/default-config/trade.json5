// Guildy - Carrefour commercial : des marchands de passage (marchands ambulants vanilla) viennent certains matins
// vendre des marchandises contre de l'or (lingots ; au-dela de 64 or : blocs d'or + lingots). Ils ne rachetent rien.
// tiers : paliers du Carrefour (index 0 = palier 1) : name, minLevel (niveau de guilde), costGold (or du tresor),
// costItems [{item, count}] (objets simples pris dans l'inventaire du joueur qui ameliore), offersMin / offersMax
// (nombre d'echanges par visite), trades (table du palier). Un Carrefour de palier N tire ses echanges dans sa table
// (poids visits.ownTierWeight) et dans celles des paliers inferieurs (poids visits.lowerTierWeight chacune).
// Echange : {item, count (lot), price (or), maxUses (echanges possibles pendant la visite), weight (chance relative),
// enchantment (optionnel, ex. minecraft:mending : livre enchante ou objet enchante), level, unique (optionnel : arme
// unique vendue a la place de l'objet : "random" = tiree dans la table "trade" d'uniques.json5 a l'arrivee du
// marchand, ou l'id d'une arme ; item n'est alors que l'icone des menus ; une seule par visite)}.
// Regles appliquees au chargement : objets en or et objets inconnus refuses ; un marchand ne vend jamais moins cher
// (a l'unite) que la boutique ni que le prix de rachat de la boutique (pas de boucle d'or ; prix releve sinon).
{

	// Version du fichier (geree automatiquement, ne pas modifier)
	"configVersion": 2,

	// Visites des marchands au Carrefour commercial
	"visits": {

		// Activer les visites naturelles (les commandes admin fonctionnent toujours)
		"enabled": true,

		// Chance de visite chaque matin = chanceBase + chancePerTier * (palier - 1)
		"chanceBase": 0.5,
		"chancePerTier": 0.15,

		// Heure du jour (ticks) du tirage du matin ; tirage possible pendant rollWindowTicks ticks (une fois par jour)
		"morningTime": 1000,
		"rollWindowTicks": 2000,

		// Duree du sejour d'un marchand (secondes)
		"staySeconds": 600,

		// Les marchands arrives de jour repartent au plus tard a la tombee de la nuit
		"leaveAtNight": true,

		// Poids du palier du Carrefour et de chaque palier inferieur dans le tirage des echanges
		"ownTierWeight": 3.0,
		"lowerTierWeight": 1.0,

		// Rayon (blocs) autour de son point d'arrivee dans lequel le marchand reste
		"homeRadius": 6
	},

	// Paliers du Carrefour (voir l'explication en haut du fichier)
	"tiers": [
