	},

	// Armes favorites de certains gardiens : poids AJOUTES a la table de la source quand le butin vient de ce contexte.
	// Cle "source@contexte" : contexte = id d'une ruine de ruins.json5 (son gardien) ou "cursed" (tout gardien maudit).
	// Exemple : "ruin_boss@grand_temple_maya": {"lance_du_jaguar_celeste": 25} = le gardien du Grand Temple tire bien
	// plus souvent la Lance du Jaguar celeste (la chance de la table ne change pas, seul le choix de l'arme change).
	"favorites": {
		"ruin_boss@grand_temple_maya": {
			"lance_du_jaguar_celeste": 25.0,
			"masque_guerrier_jaguar": 15.0,
			"pectoral_guerrier_jaguar": 15.0,
			"jambieres_guerrier_jaguar": 15.0,
			"sandales_guerrier_jaguar": 15.0
		},
		"ruin_boss@bastion_de_givre": {
			"couronne_du_roi_de_givre": 25.0,
			"heaume_hiver_eternel": 15.0,
			"cuirasse_hiver_eternel": 15.0,
			"jambieres_hiver_eternel": 15.0,
			"solerets_hiver_eternel": 15.0
		},
		"ruin_boss@temple_maya": {
			"plastron_du_serpent": 25.0,
			"masque_guerrier_jaguar": 8.0,
			"pectoral_guerrier_jaguar": 8.0,
			"jambieres_guerrier_jaguar": 8.0,
			"sandales_guerrier_jaguar": 8.0
		},
		"ruin_boss@ziggourat_des_sables": {
			"masse_du_zenith": 25.0
		},
		"nether_ruin_boss@citadelle_des_ames": {
			"egide_des_ames": 25.0,
			"heaume_brasier_des_ames": 15.0,
			"cuirasse_brasier_des_ames": 15.0,
			"greves_brasier_des_ames": 15.0,
			"bottes_brasier_des_ames": 15.0
		},
		"nether_ruin_boss@autel_infernal": {
			"hache_du_seigneur_de_guerre": 25.0,
			"heaume_brasier_des_ames": 8.0,
			"cuirasse_brasier_des_ames": 8.0,
			"greves_brasier_des_ames": 8.0,
			"bottes_brasier_des_ames": 8.0
		},
		"ruin_boss@cursed": {
			"lame_du_pacte": 30.0
		},
		"nether_ruin_boss@cursed": {
			"lame_du_pacte": 30.0
		}
	},

	// Reglages des pouvoirs (recharges en secondes, degats en points de vie : 2 = 1 coeur, distances en blocs)
	"powers": {

		// Foudrelame (storm_call) - clic droit : la foudre frappe les monstres autour du point vise
		"stormCall": {
			"cooldownSeconds": 12.0,

			// Portee de visee, rayon autour du point vise, nombre maximum de monstres foudroyes, degats par eclair
			"range": 32.0,
			"radius": 4.5,
			"maxTargets": 4,
			"damage": 10.0
		},

		// Croc-de-Givre (frost_nova) - clic droit : onde de givre autour du joueur
		"frostNova": {
			"cooldownSeconds": 18.0,

			// Rayon, degats de froid, duree (secondes) et niveau de la lenteur
			"radius": 6.0,
			"damage": 4.0,
			"slowSeconds": 6,
			"slowLevel": 3
		},

		// Murmure du Neant (blink_strike) - clic droit : se teleporte derriere le monstre vise et le frappe
		"blinkStrike": {
			"cooldownSeconds": 8.0,

			// Portee de visee et degats du coup porte apres la teleportation
			"range": 20.0,
			"damage": 10.0
		},

		// Hache de l'Ancien Forestier (tree_feller) - abat tout l'arbre naturel (accroupi : une seule buche)
		"treeFeller": {

			// Buches maximum par arbre, buches coupees par tick, feuilles naturelles minimum autour (sinon : construction)
			"maxLogs": 128,
			"logsPerTick": 12,
			"minLeaves": 4,

			// Accroupi : pouvoir desactive
			"sneakDisables": true
		},

		// Pioche du Titan (excavate) - creuse en 3x3 dans la roche naturelle (accroupi : un seul bloc)
		"excavate": {

			// Accroupi : pouvoir desactive
			"sneakDisables": true,

			// Blocs creuses en 3x3 (ids ou #tags). Jamais chez une autre guilde, jamais le coeur.
			"blocks": [
				"#minecraft:base_stone_overworld",
				"#minecraft:base_stone_nether",
				"#minecraft:ores",
				"minecraft:calcite",
				"minecraft:dripstone_block",
				"minecraft:smooth_basalt",
				"minecraft:end_stone",
				"minecraft:magma_block"
			]
		},

		// Pic du Filon (vein_miner) - extrait tout le filon de minerai (accroupi : un seul bloc)
		"veinMiner": {

			// Blocs maximum par filon
			"maxBlocks": 32,

			// Accroupi : pouvoir desactive
			"sneakDisables": true,

			// Minerais concernes (ids ou #tags). Jamais chez une autre guilde.
			"blocks": [
				"#minecraft:ores",
				"minecraft:ancient_debris"
			]
		},

		// Bottes de Zephyr (double_jump) - double saut (appuyer deux fois sur saut), pas de degats de chute
		"doubleJump": {

			// Delai minimum entre deux doubles sauts (secondes), elan vertical et vers l'avant
			"cooldownSeconds": 0.5,
			"upward": 0.75,
			"forward": 0.45
		},

		// Marteau du Seisme (shockwave) - une attaque ecrasante (en tombant) frappe aussi les monstres autour
		"shockwave": {
			"cooldownSeconds": 4.0,

			// Rayon autour de la cible, degats aux autres monstres, elan vers le haut
			"radius": 5.0,
			"damage": 8.0,
			"lift": 0.45
		},

		// Arc du Phenix (phoenix_arrows) - la fleche embrase les monstres autour de sa cible
		"phoenixArrows": {
			"cooldownSeconds": 2.0,

			// Rayon autour de la cible, degats de feu, duree d'embrasement (secondes)
			"radius": 3.5,
			"damage": 4.0,
			"fireSeconds": 5
		},

		// Trident du Leviathan (tide_call) - lance, il appelle la foudre qui rebondit sur les monstres proches
		"tideCall": {
			"cooldownSeconds": 6.0,

			// Degats de l'eclair sur la cible, nombre de rebonds, rayon et degats des rebonds
			"damage": 8.0,
			"chainTargets": 3,
			"chainRadius": 8.0,
			"chainDamage": 5.0
		},

		// Faux des Ames (soul_harvest) - chaque monstre tue soigne le porteur
		"soulHarvest": {

			// Points de vie rendus par monstre tue, duree (secondes) de la Vitesse I accordee
			"heal": 3.0,
			"speedSeconds": 3
		},

		// Lance du Jaguar celeste (jaguar_pounce) - clic droit (charge) : bond du jaguar, griffes a l'atterrissage
		"jaguarPounce": {
			"cooldownSeconds": 10.0,

			// Elan du bond vers l'avant et vers le haut (blocs par tick)
			"leap": 1.1,
			"lift": 0.5,

			// Rayon des griffes a l'atterrissage, degats, nombre maximum de monstres, duree (secondes) et niveau de la lenteur
			"radius": 3.5,
			"damage": 8.0,
			"maxTargets": 8,
			"slowSeconds": 3,
			"slowLevel": 2
		},

		// Couronne du Roi de givre (frost_crown) - gele les monstres qui frappent le porteur, qui ne gele jamais
		"frostCrown": {
			"cooldownSeconds": 3.0,

			// Degats de froid a l'attaquant, duree (secondes) et niveau de la lenteur, distance maximum d'un tireur
			"damage": 3.0,
			"freezeSeconds": 4,
			"slowLevel": 4,
			"range": 24.0,

			// Rayon de la vague de froid autour du porteur (lenteur I pour les autres monstres)
			"chillRadius": 3.0
		},

		// Egide des Ames (soul_aegis) - un coup de monstre pare au bouclier lui revient et soigne le porteur
		"soulAegis": {
			"cooldownSeconds": 1.5,

			// Part des degats bloques renvoyee (1 = 100 %), minimum et maximum renvoyes, soin du porteur, distance d'un tireur
			"reflectRatio": 1.0,
			"reflectMin": 3.0,
			"reflectMax": 30.0,
			"heal": 3.0,
			"range": 24.0
		},

		// Masse du Zenith (solar_leap) - clic droit : saut vers le ciel, un soleil eclate a l'impact
		"solarLeap": {
			"cooldownSeconds": 14.0,

			// Elan vertical et vers l'avant du saut (blocs par tick)
			"upward": 1.2,
			"forward": 0.35,

			// Rayon du soleil, degats de feu, multiplicateur contre les morts-vivants, duree d'embrasement (secondes)
			"radius": 5.0,
			"damage": 8.0,
			"undeadMultiplier": 2.0,
			"fireSeconds": 5
		},

		// Lame du Pacte (pact_seal) - chaque coup scelle le monstre, le dernier sceau ouvre un pentagramme qui eclate
		"pactSeal": {

			// Delai minimum entre deux pactes (secondes)
			"cooldownSeconds": 2.0,

			// Sceaux necessaires, duree d'un sceau sans nouveau coup (secondes), degats et duree du fletrissement (secondes)
			"seals": 3,
			"sealSeconds": 8,
			"damage": 12.0,
			"witherSeconds": 4,

			// Rayon de propagation (un sceau pour chaque monstre proche)
			"spreadRadius": 4.0
		},

		// Hache du Seigneur de guerre (infernal_rift) - clic droit : une faille de magma file droit devant
		"infernalRift": {
			"cooldownSeconds": 12.0,

			// Longueur de la faille (blocs), largeur touchee, degats de feu, embrasement (secondes), projection vers le haut
			"length": 12,
			"width": 1.4,
			"damage": 7.0,
			"fireSeconds": 4,
			"lift": 0.5
		},

		// Plastron du Serpent a plumes (jade_gale) - sous un seuil de vie, souffle de jade qui repousse les monstres
		"jadeGale": {
			"cooldownSeconds": 30.0,

			// Seuil de vie qui declenche le souffle (0.4 = 40 %), rayon, force de la poussee
			"healthThreshold": 0.4,
			"radius": 5.0,
			"push": 1.4,

			// Poison des monstres et regeneration du porteur : durees (secondes) et niveaux ; chute lente du porteur (secondes)
			"poisonSeconds": 5,
			"poisonLevel": 2,
			"regenSeconds": 5,
			"regenLevel": 2,
			"slowFallingSeconds": 4
		},

		// Panoplie de l'Hiver eternel, 4 pieces (winter_heart) - sous un seuil de vie, une nova de givre gele les monstres
		"winterHeart": {
			"cooldownSeconds": 60.0,

			// Seuil de vie apres un coup (0.3 = 30 %), rayon de la nova, degats de froid, duree (secondes) et niveau de la lenteur
			"healthThreshold": 0.3,
			"radius": 6.0,
			"damage": 6.0,
			"freezeSeconds": 5,
			"slowLevel": 4,

			// Projection des monstres, puis Resistance (duree en secondes, niveau) et Absorption (niveau) du porteur
			"push": 0.9,
			"resistanceSeconds": 6,
			"resistanceLevel": 2,
			"absorptionLevel": 2
		},

		// Panoplie du Guerrier jaguar, 4 pieces (jaguar_ambush) - accroupi, camouflage ; l'attaque suivante est une embuscade
		"jaguarAmbush": {
			"cooldownSeconds": 12.0,

			// Secondes accroupi et sans attaquer avant le camouflage (dans le feuillage : foliageSeconds), portee ou les monstres perdent votre trace
			"camouflageSeconds": 1.5,
			"foliageSeconds": 0.5,
			"loseTrackRange": 16.0,

			// Delai (secondes) pour frapper apres la fin du camouflage, degats ajoutes au coup d'embuscade
			"strikeWindowSeconds": 2.0,
			"damage": 10.0,

			// Griffes autour de la cible : rayon, degats, nombre maximum de monstres, duree (secondes) et niveau de la lenteur
			"radius": 3.5,
			"clawDamage": 6.0,
			"maxTargets": 6,
			"slowSeconds": 3,
			"slowLevel": 2
		},

		// Panoplie du Brasier des ames, 4 pieces (soul_pyre) - aura qui draine les ames des monstres, trainee de feu d'ame
		"soulPyre": {

			// Une pulsation toutes les pulseSeconds : degats aux monstres a radius blocs (maxTargets au plus), part rendue au porteur, soin maximum
			"pulseSeconds": 2.0,
			"radius": 5.0,
			"damage": 2.0,
			"maxTargets": 4,
			"healRatio": 0.5,
			"maxHeal": 3.0,

			// Trainee de feu d'ame en courant : duree d'une flamme (secondes), degats de feu et embrasement (secondes) des monstres qui la touchent
			"trailSeconds": 3.0,
			"trailDamage": 3.0,
			"fireSeconds": 3
		}
	},

	// Armes et outils uniques : id (minuscules, chiffres, _), item (objet vanilla de base), name, rarity (RARE, EPIC,
	// LEGENDARY, MYTHIC), lore (histoire, codes couleur &), enchantments {id: niveau} (vanilla ou guildy:foudroiement,
	// guildy:vampirisme, guildy:givre, guildy:brasier, guildy:echo, guildy:seisme, guildy:apesanteur, guildy:salve,
	// guildy:moisson, guildy:marque ; niveaux au-dela du maximum vanilla permis), attributes [{attribute, amount, operation
	// (add_value, add_multiplied_base, add_multiplied_total), slot (mainhand, offhand, feet, head, armor...)}] ajoutes aux
	// attributs de l'objet de base, glint (brillance), unbreakable (incassable), power (storm_call, frost_nova, blink_strike,
	// tree_feller, excavate, vein_miner, double_jump, shockwave, phoenix_arrows, tide_call, soul_harvest, jaguar_pounce,
	// frost_crown, soul_aegis, solar_leap, pact_seal, infernal_rift, jade_gale ou vide), model (texture du pack de
	// ressources, vide = apparence vanilla), color (couleur RGB du cuir teint, -1 = aucune), banner (bouclier : base = couleur
	// de fond, patterns [{pattern: minecraft:skull..., color}] = motifs de banniere vanilla, visibles sans pack),
	// set (id d'une panoplie de "sets" : la piece compte pour ses bonus, vide = aucune).
	// Les objets deja obtenus suivent le pouvoir et le modele de la config ; nom, description et enchantements restent
	// ceux de leur creation.
