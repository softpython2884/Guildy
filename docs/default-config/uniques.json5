				"lance_du_jaguar_celeste": 2.0,
				"lame_du_pacte": 0.5
			}
		},
		"nether_ruin_boss": {
			"chance": 0.25,
			"announce": true,
			"items": {
				"murmure_du_neant": 5.0,
				"foudrelame": 5.0,
				"arc_du_phenix": 5.0,
				"faux_des_ames": 4.0,
				"pioche_du_titan": 4.0,
				"bottes_de_zephyr": 4.0,
				"marteau_du_seisme": 4.0,
				"trident_du_leviathan": 2.0,
				"hache_du_seigneur_de_guerre": 4.0,
				"egide_des_ames": 3.0,
				"lame_du_pacte": 1.0
