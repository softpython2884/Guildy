		},
		"trade": {
			"chance": 1.0,
			"announce": false,
			"items": {
				"croc_de_givre": 6.0,
				"hache_sylvestre": 6.0,
				"arbalete_du_traqueur": 6.0,
				"murmure_du_neant": 5.0,
				"pic_du_filon": 5.0,
				"foudrelame": 3.0,
				"pioche_du_titan": 3.0,
