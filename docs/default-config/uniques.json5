// Guildy - armes uniques : armes et outils legendaires (enchantements de fou, pouvoirs, modeles optionnels).
// Ils tombent des boss des hordes (bien plus souvent pendant une nuit de sang), des quetes, des expeditions des
// villageois, des gardiens des ruines et se vendent parfois au Carrefour commercial palier III (trade.json5).
// Chaque exemplaire porte un numero de serie (registre : <monde>/guildy/uniques.json).
// Commandes admin : /guild admin unique list | give <joueur> <id> | registry [id] | free <id> [guilde].
{

	// Version du fichier (geree automatiquement, ne pas modifier)
	"configVersion": 5,

	// Butin : les armes uniques tombent des boss, des quetes, des expeditions et se vendent au Carrefour (false = plus aucune)
	"dropsEnabled": true,

	// Pouvoirs des armes uniques (foudre, double saut, abattage...). false = elles ne gardent que leurs enchantements
	"powersEnabled": true,

	// Unicite des armes uniques :
	// "guild" = une guilde ne recoit jamais une arme qu'elle detient deja (une autre guilde peut l'obtenir) ;
	// "server" = un seul exemplaire de chaque arme sur tout le serveur (elle redevient disponible si elle est detruite) ;
	// "none" = aucune limite (ancien comportement). Les dons des admins ignorent cette regle (avertissement).
	"uniqueness": "guild",

	// Quand toutes les armes d'une table sont deja detenues : un parchemin de sort de la meme source a la place, garanti (false = rien)
	"fallbackToScroll": true,

	// Annonce a tout le serveur quand une guilde a reuni toutes les armes uniques (collection complete)
	"announceCollection": true,

	// Protection minimale des armures uniques : "netherite" = chaque piece unique portee (casque, plastron, jambieres,
	// bottes) protege au moins comme la piece en netherite du meme emplacement (points d'armure, robustesse, resistance
	// au recul ; une valeur superieure de la definition est gardee, les exemplaires deja obtenus sont mis a jour) ;
	// "none" = seulement les valeurs de l'objet de base et de la definition.
	"armorFloor": "netherite",

	// Modeles et textures personnalises (pack de ressources) :
	// "auto" = seulement si le mod Polymer (polymer-resource-pack) est installe : Guildy ajoute ses textures a son pack ;
	// "on" = toujours (l'admin heberge guildy-resourcepack-<version>.zip : resource-pack= dans server.properties) ;
	// "off" = jamais : les armes gardent l'apparence de leur objet de base (nom, description et brillance)
	"customModels": "auto",

	// Avec Polymer : pack de ressources obligatoire (sinon un joueur qui le refuse verrait des textures manquantes)
	"polymerRequired": true,

	// Annonce a tout le serveur quand un joueur obtient une arme unique
	"announce": {

		// Raretes annoncees a tout le serveur (RARE, EPIC, LEGENDARY, MYTHIC)
		"rarities": [
			"LEGENDARY",
			"MYTHIC"
		],

		// Son joue a tous les joueurs lors de l'annonce
		"sound": true
	},

	// Tables de butin par source : chance (0 a 1) qu'une arme unique tombe, puis tirage pondere dans items {id: poids}.
	// Sources : boss (boss des hordes), blood_boss (boss pendant une nuit de sang), quest (recompense de quete, rare),
	// legendary_quest (quete legendaire), expedition (expeditions des villageois), trade (Carrefour commercial : l'offre
	// "arme unique" de trade.json5 tire ici l'arme proposee), ruin_boss / nether_ruin_boss (boss des ruines de l'Overworld
	// / du Nether, ruins.json5). announce : annoncer l'obtention (raretes de "announce").
	"drops": {
		"boss": {
			"chance": 0.04,
			"announce": true,
			"items": {
				"coutelas_du_contrebandier": 10.0,
				"bottes_du_coursier": 10.0,
				"pic_du_filon": 8.0,
				"croc_de_givre": 6.0,
				"hache_sylvestre": 6.0,
				"arbalete_du_traqueur": 5.0,
				"murmure_du_neant": 4.0,
				"foudrelame": 2.0,
				"pioche_du_titan": 2.0,
				"bottes_de_zephyr": 2.0,
				"arc_du_phenix": 2.0,
				"marteau_du_seisme": 2.0
			}
		},
		"blood_boss": {
			"chance": 0.2,
			"announce": true,
			"items": {
				"croc_de_givre": 6.0,
				"hache_sylvestre": 5.0,
				"arbalete_du_traqueur": 5.0,
				"murmure_du_neant": 5.0,
				"foudrelame": 5.0,
				"pioche_du_titan": 4.0,
				"bottes_de_zephyr": 4.0,
				"arc_du_phenix": 4.0,
				"marteau_du_seisme": 4.0,
				"trident_du_leviathan": 2.0,
				"faux_des_ames": 2.0
			}
		},
		"quest": {
			"chance": 0.01,
			"announce": true,
			"items": {
				"coutelas_du_contrebandier": 10.0,
				"bottes_du_coursier": 10.0,
				"pic_du_filon": 8.0,
				"croc_de_givre": 4.0,
				"hache_sylvestre": 4.0,
				"arbalete_du_traqueur": 3.0
			}
		},
		"legendary_quest": {
			"chance": 0.35,
			"announce": true,
			"items": {
				"croc_de_givre": 5.0,
				"hache_sylvestre": 5.0,
				"arbalete_du_traqueur": 5.0,
				"murmure_du_neant": 5.0,
				"foudrelame": 4.0,
				"pioche_du_titan": 4.0,
				"bottes_de_zephyr": 4.0,
				"arc_du_phenix": 4.0,
				"marteau_du_seisme": 4.0,
				"trident_du_leviathan": 1.0,
				"faux_des_ames": 1.0,
				"lance_du_jaguar_celeste": 1.0,
				"couronne_du_roi_de_givre": 1.0,
				"egide_des_ames": 1.0,
				"masse_du_zenith": 1.0,
				"hache_du_seigneur_de_guerre": 1.0,
				"plastron_du_serpent": 1.0,
				"lame_du_pacte": 0.5,
				"heaume_hiver_eternel": 0.5,
				"cuirasse_hiver_eternel": 0.5,
				"jambieres_hiver_eternel": 0.5,
				"solerets_hiver_eternel": 0.5,
				"masque_guerrier_jaguar": 0.5,
				"pectoral_guerrier_jaguar": 0.5,
				"jambieres_guerrier_jaguar": 0.5,
				"sandales_guerrier_jaguar": 0.5,
				"heaume_brasier_des_ames": 0.5,
