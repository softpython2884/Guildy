	// Reglages des pouvoirs (recharges en secondes, degats en points de vie : 2 = 1 coeur, distances en blocs)
	"powers": {

		// Foudrelame (storm_call) - clic droit : la foudre frappe les monstres autour du point vise
		"stormCall": {
			"cooldownSeconds": 12.0,

			// Portee de visee, rayon autour du point vise, nombre maximum de monstres foudroyes, degats par eclair
			"range": 32.0,
			"radius": 4.5,
			"maxTargets": 4,
			"damage": 10.0
		},

		// Croc-de-Givre (frost_nova) - clic droit : onde de givre autour du joueur
		"frostNova": {
			"cooldownSeconds": 18.0,

			// Rayon, degats de froid, duree (secondes) et niveau de la lenteur
			"radius": 6.0,
			"damage": 4.0,
			"slowSeconds": 6,
			"slowLevel": 3
		},

		// Murmure du Neant (blink_strike) - clic droit : se teleporte derriere le monstre vise et le frappe
		"blinkStrike": {
			"cooldownSeconds": 8.0,

			// Portee de visee et degats du coup porte apres la teleportation
			"range": 20.0,
			"damage": 10.0
		},

		// Hache de l'Ancien Forestier (tree_feller) - abat tout l'arbre naturel (accroupi : une seule buche)
		"treeFeller": {

			// Buches maximum par arbre, buches coupees par tick, feuilles naturelles minimum autour (sinon : construction)
			"maxLogs": 128,
			"logsPerTick": 12,
			"minLeaves": 4,

			// Accroupi : pouvoir desactive
			"sneakDisables": true
		},

		// Pioche du Titan (excavate) - creuse en 3x3 dans la roche naturelle (accroupi : un seul bloc)
		"excavate": {

			// Accroupi : pouvoir desactive
			"sneakDisables": true,

			// Blocs creuses en 3x3 (ids ou #tags). Jamais chez une autre guilde, jamais le coeur.
			"blocks": [
				"#minecraft:base_stone_overworld",
				"#minecraft:base_stone_nether",
				"#minecraft:ores",
				"minecraft:calcite",
				"minecraft:dripstone_block",
				"minecraft:smooth_basalt",
				"minecraft:end_stone",
				"minecraft:magma_block"
			]
		},

		// Pic du Filon (vein_miner) - extrait tout le filon de minerai (accroupi : un seul bloc)
		"veinMiner": {

			// Blocs maximum par filon
			"maxBlocks": 32,

			// Accroupi : pouvoir desactive
			"sneakDisables": true,

			// Minerais concernes (ids ou #tags). Jamais chez une autre guilde.
			"blocks": [
				"#minecraft:ores",
				"minecraft:ancient_debris"
			]
		},

		// Bottes de Zephyr (double_jump) - double saut (appuyer deux fois sur saut), pas de degats de chute
		"doubleJump": {

			// Delai minimum entre deux doubles sauts (secondes), elan vertical et vers l'avant
			"cooldownSeconds": 0.5,
			"upward": 0.75,
			"forward": 0.45
		},

		// Marteau du Seisme (shockwave) - une attaque ecrasante (en tombant) frappe aussi les monstres autour
		"shockwave": {
			"cooldownSeconds": 4.0,

			// Rayon autour de la cible, degats aux autres monstres, elan vers le haut
			"radius": 5.0,
			"damage": 8.0,
			"lift": 0.45
		},

		// Arc du Phenix (phoenix_arrows) - la fleche embrase les monstres autour de sa cible
		"phoenixArrows": {
			"cooldownSeconds": 2.0,

			// Rayon autour de la cible, degats de feu, duree d'embrasement (secondes)
			"radius": 3.5,
			"damage": 4.0,
			"fireSeconds": 5
		},

		// Trident du Leviathan (tide_call) - lance, il appelle la foudre qui rebondit sur les monstres proches
		"tideCall": {
			"cooldownSeconds": 6.0,

			// Degats de l'eclair sur la cible, nombre de rebonds, rayon et degats des rebonds
			"damage": 8.0,
			"chainTargets": 3,
			"chainRadius": 8.0,
			"chainDamage": 5.0
		},

		// Faux des Ames (soul_harvest) - chaque monstre tue soigne le porteur
		"soulHarvest": {

			// Points de vie rendus par monstre tue, duree (secondes) de la Vitesse I accordee
			"heal": 3.0,
			"speedSeconds": 3
		}
	},

	// Armes et outils uniques : id (minuscules, chiffres, _), item (objet vanilla de base), name, rarity (RARE, EPIC,
	// LEGENDARY, MYTHIC), lore (histoire, codes couleur &), enchantments {id: niveau} (vanilla ou guildy:foudroiement,
	// guildy:vampirisme, guildy:givre, guildy:brasier, guildy:echo, guildy:seisme, guildy:apesanteur, guildy:salve,
	// guildy:moisson, guildy:marque ; niveaux au-dela du maximum vanilla permis), attributes [{attribute, amount, operation
	// (add_value, add_multiplied_base, add_multiplied_total), slot (mainhand, offhand, feet, head, armor...)}] ajoutes aux
	// attributs de l'objet de base, glint (brillance), unbreakable (incassable), power (storm_call, frost_nova, blink_strike,
	// tree_feller, excavate, vein_miner, double_jump, shockwave, phoenix_arrows, tide_call, soul_harvest ou vide), model
	// (texture du pack de ressources, vide = apparence vanilla), color (couleur RGB du cuir teint, -1 = aucune).
	// Les objets deja obtenus suivent le pouvoir et le modele de la config ; nom, description et enchantements restent
	// ceux de leur creation.
