		"expedition": {
			"chance": 0.02,
			"announce": true,
			"items": {
				"coutelas_du_contrebandier": 10.0,
				"bottes_du_coursier": 10.0,
				"pic_du_filon": 8.0,
				"hache_sylvestre": 4.0,
				"croc_de_givre": 3.0,
				"arbalete_du_traqueur": 3.0,
