				"croc_de_givre": 6.0,
				"hache_sylvestre": 5.0,
				"arbalete_du_traqueur": 5.0,
				"murmure_du_neant": 5.0,
				"foudrelame": 4.0,
				"pioche_du_titan": 4.0,
				"bottes_de_zephyr": 4.0,
				"arc_du_phenix": 4.0,
				"marteau_du_seisme": 4.0,
				"trident_du_leviathan": 2.0,
				"faux_des_ames": 1.0,
				"couronne_du_roi_de_givre": 3.0,
