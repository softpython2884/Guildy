	// Tache 'Bucheron' : coupe reelle des arbres naturels du territoire autour de la zone de travail
	"lumberjack": {

		// Rayon (blocs) de recherche des arbres autour de la zone de travail
		"radius": 16,

		// Nombre maximum de buches d'un arbre (les arbres plus grands sont ignores)
		"maxLogsPerTree": 80,

		// Replanter une pousse a la base de l'arbre coupe (si le sol le permet)
		"replant": true
	},

	// Tache 'Fermier' : recolte les cultures mures autour de la zone de travail et les replante
	"farmer": {

		// Rayon (blocs) de recolte autour de la zone de travail
		"radius": 8,

		// Hauteur (blocs) au-dessus et en dessous de la zone de travail ou chercher des cultures
		"verticalRange": 3,

		// Nombre maximum de cultures recoltees par seconde
		"harvestPerSecond": 3
	},

	// Tache 'Garde' : attaque les monstres du territoire, defend le coeur pendant les vagues
	"guard": {

		// Rayon (blocs) de surveillance autour du point de garde (zone de travail, sinon le coeur)
		"radius": 16,

		// Degats par coup au niveau 1 de la guilde
		"damage": 4.0,

		// Degats supplementaires par niveau de guilde
		"damagePerLevel": 0.5,

		// Delai (ticks, 20 = 1 seconde) entre deux coups
		"attackCooldownTicks": 20,

		// Distance (blocs) a laquelle le garde peut frapper
		"attackReach": 2.5,

		// Abandonner une cible qu'on n'arrive pas a atteindre apres ce delai (secondes)
		"chaseTimeoutSeconds": 20,

		// Monstres ignores par les gardes
		"ignoredMobs": [
			"minecraft:creeper",
			"minecraft:phantom",
			"minecraft:ghast",
			"minecraft:enderman"
		]
	},

	// Stockage de la guilde (coffres de depot et coffres par categorie)
	"storage": {

		// Categories de rangement, dans l'ordre de priorite (la premiere qui correspond l'emporte).
		// Chaque valeur est un id d'objet (minecraft:diamond) ou un tag d'objet precede de # (#minecraft:logs).
