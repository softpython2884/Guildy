		// Objectifs prioritaires du mineur ou de la zone : poids multiplie dans les tables de butin (1 = aucun effet)
		"wishlistWeight": 4
	},

	// Tache 'Mineur', mode 'Reel' (zones de mine) : les mineurs creusent vraiment. Depuis le fanion, un escalier en
	// colimacon (2 blocs de large, 3 de haut) descend ; tous les 'levelSpacing' blocs, un niveau : un palier puis une
	// galerie principale avec des galeries laterales tous les 3 blocs (objectif 'Pierre' : une carriere, voir stoneQuarry),
	// toujours dans le carre de la zone. Les niveaux s'ouvrent pendant que l'escalier continue de descendre jusqu'a la
	// profondeur cible : plusieurs mineurs (jusqu'a 'maxMinersPerZone') se partagent les chantiers. Les minerais et les
	// objectifs prioritaires visibles sont mines en suivant leurs filons (un peu hors de la zone aussi). Seuls des blocs
	// naturels sont casses (listes ci-dessous) : jamais un bloc pose par un joueur, un bloc a donnees (coffre...), un bloc
	// d'une autre guilde, ni un bloc naturel qui porte un bloc non naturel. L'eau et la lave sont colmatees avec un bloc
	// du sac (sinon la galerie est abandonnee) et les trous du sol combles.
	"realMining": {

		// Mode des nouvelles zones de mine (et des anciennes sans reglage) : true = reel, false = simule
		"defaultReal": true,

		// Temps (ticks, 20 = 1 seconde) pour casser un bloc ; le bonus de vitesse de travail s'applique (4 blocs/s max)
		"ticksPerBlock": 20,

		// Objectif 'Minerais' : profondeur cible par defaut (Y du sol des galeries ; -54 = couche des diamants)
		"oresTargetY": -54,

		// Objectif 'Tout venant' : profondeur cible par defaut (Y)
		"mixedTargetY": 16,

		// Objectif 'Pierre et variantes' : profondeur par defaut des galeries sous le fanion (blocs)
		"stoneDepth": 12,

		// Profondeur minimum des galeries sous le fanion (blocs) : jamais de tranchee a la surface
		"minDepthBelowFanion": 4,

		// Ecart (blocs) entre deux niveaux de galeries (un palier de l'escalier tous les N blocs, du premier niveau sous
		// la surface jusqu'a la profondeur cible) ; aussi le pas des boutons de profondeur du menu de la zone
		"levelSpacing": 6,

		// Escalier arrive a la profondeur cible et tous les niveaux termines (ou des mineurs sans travail) : l'escalier
		// descend ouvrir les niveaux suivants, plus bas (jusqu'au fond du monde)
		"autoNextLevel": true,

		// Cote (blocs) du carre interieur de l'escalier en colimacon (3 a 6) : une marche = 1 bloc plus bas
		"stairSide": 4,

		// Largeur des nouveaux escaliers : 2 = deux voies (les mineurs se croisent sans se gener, le carre fait 2 blocs de
		// plus de cote ; 1 voie si la zone est trop petite), 1 = une voie. Les escaliers deja creuses gardent leur largeur.
		"stairWidth": 2,

		// Nombre maximum de mineurs qui travaillent en meme temps dans une meme mine reelle (menu : affectation refusee au-dela)
		"maxMinersPerZone": 20,

		// Longueur maximum de la galerie principale (blocs ; coupee au bord de la zone)
		"mainTunnelLength": 32,

		// Ecart entre deux galeries laterales (blocs, 2 minimum)
		"branchSpacing": 3,

		// Longueur de chaque galerie laterale (blocs ; coupee au bord de la zone)
		"branchLength": 12,

		// Objectif 'Pierre' : largeur des salles de carriere (blocs, impair)
		"roomWidth": 5,

		// Objectif 'Pierre' : longueur des salles de carriere (blocs)
		"roomLength": 5,

		// Objectif 'Pierre' : hauteur des salles de carriere (blocs)
		"roomHeight": 3,

		// Objectif 'Pierre' : couloir entre deux salles (blocs)
		"roomGap": 2,

		// Blocs suivis au plus par filon (minerais et objectifs prioritaires visibles depuis les tunnels, sol compris ;
		// 0 = ne pas suivre les filons). Hors de portee : un autre mineur le suit plus tard en creusant un tunnel d'approche.
		"maxVeinBlocks": 64,

		// Distance (blocs) au-dela du bord de la zone jusqu'a laquelle un filon est suivi (jamais chez une autre guilde)
		"veinMaxOutside": 16,

		// Blocs de remplissage (pierre taillee...) gardes dans le sac pour colmater et combler : ils restent dans le sac au
		// coffre de depot (sauf fin de mission). Objectif 'Minerais' : le reste des gravats est laisse sur place.
		"fillerReserve": 32,

		// Une torche toutes les N marches / N blocs de galerie (0 = pas de torche)
		"torchInterval": 8,

		// Les torches utilisent le charbon du sac quand il y en a (1 charbon = 4 torches, + 1 baton s'il y en a)
		"torchesUseCoal": true,

		// Sans charbon dans le sac : torche gratuite (true) ou pas de torche (false)
		"freeTorches": true,

		// Trou dans le sol et aucun bloc de remplissage dans le sac : pierre taillee gratuite (true) ou galerie abandonnee
		"freeFloorBlocks": true,

		// Heure (ticks du jour, 0 a 24000) a partir de laquelle le mineur remonte avant la nuit (-1 = jamais)
		"surfaceAtTime": 10500,

		// Blocs naturels que le mineur peut casser (id ou #tag ; les blocs a donnees ne sont jamais casses)
		"naturalBlocks": [
			"#minecraft:base_stone_overworld",
			"#minecraft:substrate_overworld",
			"#minecraft:sand",
			"minecraft:gravel",
			"minecraft:clay",
			"minecraft:sandstone",
			"minecraft:red_sandstone",
			"minecraft:calcite",
			"minecraft:dripstone_block",
			"minecraft:pointed_dripstone",
			"minecraft:smooth_basalt",
			"minecraft:magma_block",
			"minecraft:snow_block",
			"minecraft:infested_stone",
			"minecraft:infested_deepslate"
		],

		// Minerais (cassables, suivis en filon ; seuls gardes avec l'objectif 'Minerais')
		"oreBlocks": [
			"#minecraft:ores",
			"#minecraft:gold_ores",
			"minecraft:raw_iron_block",
			"minecraft:raw_copper_block"
		],

		// Objets du sac utilisables pour colmater l'eau et la lave et combler les trous (blocs pleins, jamais de sable)
		"fillerItems": [
			"minecraft:cobblestone",
			"minecraft:cobbled_deepslate",
			"minecraft:dirt",
			"minecraft:stone",
			"minecraft:deepslate",
			"minecraft:andesite",
			"minecraft:diorite",
			"minecraft:granite",
			"minecraft:tuff",
			"minecraft:calcite",
			"minecraft:netherrack"
		],

		// Objectif 'Pierre et variantes' : carriere a ciel ouvert (true) au lieu des salles de carriere (false). Les mineurs
		// creusent tout le carre de la zone par gradins depuis la surface jusqu'a la profondeur cible ; il ne reste que
		// l'escalier (une tour entouree d'un mur de roche d'un bloc, une ouverture par gradin) et une chaussee de roche
		// qui relie le fanion au bord de la carriere. Les mines 'Pierre' deja commencees passent en carriere (les
		// galeries creusees sont simplement vides).
		"stoneQuarry": true,

		// Carriere : hauteur (blocs) d'un gradin (2 a 5 ; au-dela de 3, une chute d'un gradin blesse)
		"quarryBenchHeight": 3,

		// Carriere : blocs laisses intacts le long du bord de la zone (0 = jusqu'au bord)
		"quarryMargin": 0,

		// Carriere : largeur (blocs) de la chaussee de roche laissee entre le fanion et le bord de la carriere (1 a 4)
		"quarryAccessWidth": 2,

		// Carriere : longueur maximum (blocs) d'une bande, le chantier d'un mineur (2 a 32)
		"quarryStripLength": 8,

		// Carriere : blocs naturels (colline) au-dessus du sol du fanion retires par le premier gradin, jusqu'a cette
		// hauteur (0 a 32) ; plus haut, ils restent (et le sable ou le gravier tombe dans la carriere, puis est creuse)
		"quarryClearAbove": 8,

		// Carriere : objets gardes dans le sac (id ou #tag d'objet) ; les minerais et les objectifs prioritaires sont
		// toujours gardes, plus une reserve de blocs de remplissage (fillerReserve)
		"quarryKeep": [
			"minecraft:cobblestone",
			"minecraft:cobbled_deepslate",
			"minecraft:stone",
			"minecraft:deepslate",
			"minecraft:andesite",
			"minecraft:diorite",
			"minecraft:granite",
			"minecraft:tuff",
			"minecraft:calcite",
			"minecraft:dripstone_block",
			"minecraft:smooth_basalt",
			"minecraft:sandstone",
			"minecraft:red_sandstone",
			"minecraft:clay_ball",
			"minecraft:flint"
		],

		// Carriere : les autres blocs (terre, gravier, sable...) sont jetes (true) ou rapportes au coffre (false)
		"quarryDiscardOthers": true,

		// Carriere : vegetation naturelle retiree au lieu de bloquer le creusage (id ou #tag de bloc), en plus des regles
		// fixes : plantes sans collision (herbes, fleurs, lianes...), feuilles naturelles (jamais celles posees par un
		// joueur), troncs droits qui finissent dans des feuilles naturelles, torches de la carriere. Tout autre bloc non
		// naturel pose sur une colonne (construction, poteau de buches...) la garde intacte jusqu'au fond (colonne de
		// soutien).
		"quarrySurfaceClear": [
			"minecraft:snow",
			"minecraft:powder_snow",
			"minecraft:cactus",
			"minecraft:bamboo",
			"minecraft:pumpkin",
			"minecraft:melon",
			"minecraft:brown_mushroom_block",
			"minecraft:red_mushroom_block",
			"minecraft:mushroom_stem",
			"minecraft:moss_carpet",
			"minecraft:pale_moss_carpet",
			"minecraft:azalea",
			"minecraft:flowering_azalea",
			"minecraft:big_dripleaf",
			"minecraft:big_dripleaf_stem",
			"minecraft:mangrove_roots",
			"minecraft:muddy_mangrove_roots"
		]
	},

	// Tache 'Bucheron' : coupe reelle des arbres naturels de sa zone (sans zone : les plus proches de lui)
	"lumberjack": {

		// Nombre maximum de buches d'un arbre (les arbres plus grands sont ignores ; 160 : sapins et acajous geants compris)
		"maxLogsPerTree": 160,

		// Replanter une pousse a la base de l'arbre coupe (si le sol le permet)
		"replant": true,

		// Plantation : quand il n'a plus d'arbre a couper, le bucheron plante de nouvelles pousses sur le sol naturel libre de
		// sa coupe de bois (herbe, terre, podzol, mousse, boue ; jamais un chemin, une terre labouree, a cote d'un bloc pose par
		// un joueur ni a moins de 4 blocs d'une autre guilde). Essence : celle de la zone, puis celles des objectifs prioritaires,
		// puis les pousses de son sac ou des coffres du stockage (Graines et pousses, depot, Divers) pour une zone 'Tous les arbres'.
		// Chene noir et chene pale ne poussent qu'en carre : plantes par 4 (sur sol plat), sinon ignores
		"plantSaplings": true,

		// Planter aussi en mode automatique (sans zone : dans le territoire et autour)
		"plantInAutoMode": false,

		// Ecart (blocs) : aucune buche ni pousse a cette distance ou moins d'une nouvelle pousse (4 = 4 blocs libres entre deux troncs ; 2 a 12)
		"plantSpacing": 4,

		// Densite : arbres (troncs et pousses) par chunk au-dela desquels il ne plante plus dans ce chunk (1 a 64)
		"plantMaxPerChunk": 8,

		// Hauteur libre (blocs) exigee au-dessus d'une pousse (2 a 16)
		"plantHeadroom": 6,

		// Pousses plantees par tournee avant de chercher de nouveau des arbres a couper (1 a 64)
		"plantPerRound": 12,

		// Prendre des pousses dans les coffres du stockage quand son sac n'en a plus
		"plantFromStorage": true,

		// Pousses prises au stockage en un voyage (1 a 64)
		"plantFetchAmount": 16,

		// Attente (secondes) avant de reessayer quand il n'y a plus de place ou plus de pousses (10 a 3600)
		"plantPauseSeconds": 60,

		// Ramasser les pousses tombees au sol pres de lui (feuillage qui se decompose apres une coupe)
		"pickUpSaplings": true,

		// Mettre de la poudre d'os (sac, sinon stockage) sur les pousses plantees
		"useBoneMeal": false
	},

	// Tache 'Fermier' : recolte les cultures mures de sa zone (sans zone : les plus proches de lui) et les replante
	"farmer": {

		// Cultures sous abri : hauteur (blocs) au-dessus et en dessous du fanion (sans zone : du villageois)
		// ou les chercher en plus de la surface
		"verticalRange": 3,

		// Nombre maximum de cultures recoltees par seconde
		"harvestPerSecond": 3,

		// Semis : quand rien n'est mur, le fermier seme les terres labourees vides de ses champs : d'abord les cultures des
		// objectifs prioritaires, puis celle de la zone, puis les graines, carottes, pommes de terre ou graines de betterave de
		// son sac ou des coffres du stockage (Graines et pousses, Nourriture, depot, Divers) pour une zone 'Toutes les cultures'.
		// Melons, citrouilles et canne a sucre ne sont pas semes (la tige et la base restent a la recolte).
		// Dans une zone, autorisation 'Semer' du fanion
		"sow": true,

		// Semer aussi en mode automatique (sans zone : terres labourees du territoire et autour)
		"sowInAutoMode": true,

		// Zones de champs seulement (autorisation 'Labourer' du fanion) : labourer l'herbe, la terre, la terre sterile et la
		// terre racinee hydratees (eau a 4 blocs ou moins, portee vanilla ; les points d'eau creuses comptent), rien dessus,
		// jamais un chemin, ni a cote d'un bloc pose par un joueur (sauf terre labouree, eau, barrieres, torches, lanternes,
		// chemins, composteurs...). false = aucun labour nouveau dans aucune zone
		"tillSoil": true,

		// Cultures semees par tournee avant de chercher de nouveau des cultures mures (1 a 256)
		"sowPerRound": 32,

		// Prendre des graines dans les coffres du stockage quand son sac n'en a plus
		"sowFromStorage": true,

		// Graines prises au stockage en un voyage (1 a 64)
		"sowFetchAmount": 32,

		// Attente (secondes) avant de reessayer quand il n'y a plus rien a semer ou plus de graines (10 a 3600)
		"sowPauseSeconds": 30,

		// Travaux des champs (zones de champs) : chaque zone choisit les siens dans le menu de la zone, bouton
		// 'Autorisations du fanion' (recolter, replanter, semer, relabourer, labourer, points d'eau, degager, aplanir,
		// poudre d'os ; preselections 'Entretenir un champ' et 'Creer des champs'). Sans zone : recolte et semis seulement
		"fieldWork": {

			// Travaux des champs (zones de champs seulement, selon les autorisations du fanion de chaque zone) : labourer, degager
			// le sol, creuser des points d'eau, aplanir, poudre d'os, relabourer la terre pietinee. false = aucun de ces travaux
			// (le fermier recolte, replante et seme seulement)
			"enabled": true,

			// Actions (labour, trou d'eau, aplanissement, poudre d'os...) par seconde au plus (1 a 16)
			"actionsPerSecond": 3,

			// Actions par tournee de travaux avant de chercher de nouveau des cultures mures (1 a 512)
			"perRound": 48,

			// Chunks de la zone inspectes par seconde avant une tournee de travaux (1 a 16)
			"surveyChunksPerStep": 2,

			// Attente (secondes) avant d'inspecter de nouveau un champ ou il n'y avait plus rien a faire (10 a 3600)
			"pauseSeconds": 60,

			// Terres labourees redevenues de la terre (pietinees, dessechees) retenues par zone pour etre relabourees puis
			// ressemees (0 a 4096, 0 = rien n'est retenu)
			"retillMemory": 256,

			// Prendre de la terre (aplanir) et de la poudre d'os dans les coffres du stockage quand son sac n'en a plus
			"fromStorage": true,

			// Terre ou poudre d'os prise au stockage en un voyage (1 a 64)
			"fetchAmount": 16,

			// Poudre d'os : cultures traitees par tournee au plus (1 a 256)
			"boneMealPerRound": 16
		},

		// Points d'eau creuses par les fermiers (autorisation 'Creer des points d'eau' d'une zone de champs)
		"irrigation": {

			// Seaux d'eau consommes par point d'eau creuse ou rempli (0 a 4 ; 0 = eau gratuite). Plus de 0 : le fermier prend les
			// seaux d'eau dans les coffres du stockage (depot, categorie, Divers) et rapporte les seaux vides au coffre de depot
			"waterBucketCost": 0,

			// Seaux d'eau pris au stockage en un voyage (1 a 16)
			"bucketFetchAmount": 4,

			// Points d'eau retenus (et remplis s'ils disparaissent) par zone au plus (1 a 4096)
			"maxHolesPerZone": 512
		}
	},

	// Tache 'Garde' : patrouille (zone ou parcours) ou defend le coeur ; pendant les vagues, defend toujours le coeur
	"guard": {

		// Rayon (blocs) de surveillance du garde (autour du coeur sans zone, autour de lui en patrouille)
		"radius": 16,

		// Zone de patrouille : marge (blocs) autour de la zone ou le garde attaque encore les monstres
		"zoneMargin": 8,

		// Degats par coup au niveau 1 de la guilde
		"damage": 4.0,

		// Degats supplementaires par niveau de guilde, jusqu'au niveau 10
		"damagePerLevel": 0.5,

		// Au-dela du niveau 10 : degats supplementaires par niveau, au plus maxDamageAbove10 pour ces niveaux (0 = sans
		// plafond). Par defaut : 8.5 au niveau 10, 13 a partir du niveau 100 (avant l'equipement et l'arbre d'evolution)
		"damagePerLevelAbove10": 0.05,
		"maxDamageAbove10": 4.5,

		// Delai (ticks, 20 = 1 seconde) entre deux coups
		"attackCooldownTicks": 20,

		// Distance (blocs) a laquelle le garde peut frapper
		"attackReach": 2.5,

		// Abandonner une cible qu'on n'arrive pas a atteindre apres ce delai (secondes)
		"chaseTimeoutSeconds": 20,

		// Monstres ignores par les gardes
		"ignoredMobs": [
			"minecraft:creeper",
			"minecraft:phantom",
			"minecraft:ghast",
			"minecraft:enderman"
		],

		// Roles : epeiste (corps a corps) ou archer (fleches). Role 'Auto' (par defaut, modifiable dans le menu du garde) :
		// le role qui rapproche la part d'archers parmi les gardes de la guilde de cette valeur (0 = que des epeistes,
		// 1 = que des archers, 0.5 = moitie-moitie)
		"archerShare": 0.5,

		// Archers : portee maximum de tir (blocs ; il faut voir le monstre)
		"bowRange": 16,

		// Archers : en dessous de cette distance (blocs), l'archer recule pour garder ses distances
		"bowMinDistance": 5.0,

		// Archers : degats d'une fleche = degats d'un coup d'epee (damage, damagePerLevel, arbre d'evolution) x ce facteur
		"bowDamageFactor": 1.0,

		// Archers : delai (ticks, 20 = 1 seconde) entre deux tirs
		"bowCooldownTicks": 30,

		// Archers : imprecision des tirs (0 = parfait ; un squelette en difficulte difficile = 2)
		"bowInaccuracy": 2.0,

		// Monstres ignores par les archers (liste a part : ils peuvent tirer sur des monstres que les epeistes ne
		// peuvent pas atteindre, comme les phantoms). Leurs fleches ne touchent que les monstres : jamais un joueur,
		// un villageois, un animal de compagnie ou un animal passif.
		"bowIgnoredMobs": [
			"minecraft:creeper",
			"minecraft:enderman"
		],

		// Repli : sous cette part de sa vie (0 a 1, 0 = jamais), le garde arrete de combattre et court (bonus de vitesse)
		// se soigner a son lit (sinon le lit le plus proche du territoire, sinon le bureau d'accueil ou le coeur), meme
		// pendant une horde. Il frappe encore les monstres a portee de bras en chemin.
		"retreatHealthRatio": 0.4,

		// Repli : le garde reprend son poste (patrouille, parcours, defense du coeur) une fois soigne a cette part de sa vie
		"resumeHealthRatio": 0.9,

		// Soin pendant le repli, loin d'un lit (points de vie par seconde ; 2 points = 1 coeur, un villageois en a 20)
		"healPerSecond": 0.5,

		// Soin a cote de son lit (points de vie par seconde)
		"bedHealPerSecond": 1.0,

		// Regeneration lente hors combat (points de vie par seconde, 0 = aucune ; les villageois ne regenerent pas seuls)
		"passiveRegenPerSecond": 0.1,

		// Repli : niveau de l'effet Vitesse pendant la course vers le lit (0 = aucun, 2 = Vitesse II)
		"retreatSpeedLevel": 2,

		// Equipement : hors combat, les gardes vont prendre les meilleures pieces d'armure (points d'armure, puis
		// robustesse ; toute matiere, enchantees ou non) dans les coffres du stockage enregistres (menu Villageois ->
		// Stockage : depot et categories) et rapportent l'ancienne piece. Une piece cassee est remplacee plus tard.
		"equipmentFromChests": true,

		// Equipement : les gardes prennent aussi une meilleure epee (epeistes) ou un meilleur arc enchante (archers)
		"weaponsFromChests": true,

		// Equipement : intervalle (secondes) entre deux recherches d'equipement dans les coffres
		"equipmentScanSeconds": 30,

		// Equipement : les armures des gardes s'usent quand ils sont blesses (comme celles des joueurs)
		"armorWear": true,

		// Equipement : a la mort d'un garde, son equipement (armure, arme des coffres) tombe au sol (false = perdu avec lui)
		"dropEquipmentOnDeath": true
	},

	// Equipement de base des gardes selon le niveau de la guilde : epee, arc ou arbalete, armure. Gratuit, il ne peut pas
