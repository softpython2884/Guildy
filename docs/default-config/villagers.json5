		// Categorie implicite des objets qui ne correspondent a aucune categorie ; ses coffres recoivent aussi ce qui n'a
		// pas de coffre dedie (ou dont les coffres sont pleins). Sans coffre 'Divers', ces objets restent au depot.
		"fallbackCategory": "Divers",

		// Nombre maximum de conteneurs enregistres par guilde hors des salles des coffres (voir maxRoomChests)
		"maxChests": 48,

		// Nommer les conteneurs enregistres (titre affiche a l'ouverture : 'Depot', 'Minerais et lingots'...)
		"labelChests": true,

		// Duree (secondes) du bouton 'Afficher les coffres' (particules visibles par le joueur seul)
		"showSeconds": 20,

		// Ordre de rangement par defaut des groupes de coffres (modifiable par guilde dans le menu Stockage) :
		// 'columns' = chaque colonne de haut en bas, colonnes de gauche a droite vues de face ; 'rows' = chaque rangee de
		// gauche a droite, rangees de haut en bas. Dans une salle des coffres, les categories recoivent des colonnes (ou
		// des rangees) entieres.
		"defaultOrder": "columns",

		// Rangement dans chaque coffre par defaut (modifiable par guilde dans le menu Stockage ou par
		// /guild villagers storage layout) : 'columns' = chaque colonne de haut en bas, colonnes de gauche a droite, et
		// chaque nouvel objet commence en haut d'une nouvelle colonne s'il reste la place ; 'rows' = emplacements dans
		// l'ordre de lecture (rangee par rangee).
		"defaultChestLayout": "columns",

		// Coffres filtres (contenu impose : une famille comme 'diorite' ou 'laine', ou une liste d'objets) : nombre
		// maximum par guilde (en plus de maxChests et maxRoomChests ; 0 = desactive)
		"maxFilterChests": 256,

		// Filtre d'apres le contenu d'un coffre : une liste exacte d'objets est proposee jusqu'a N objets differents
		// (au-dela, sans famille commune, le coffre devient un coffre de categorie ou reste tel quel) (1 a 54)
		"filterMaxItems": 9,

		// Commande /guild villagers storage scan <chunks> : un coffre trop melange pour un filtre devient un coffre de sa
		// categorie principale si elle represente au moins N % de ses piles (50 a 100)
		"scanCategoryPercent": 75,

		// Commande scan : rayon maximum (chunks) autour du joueur (1 a 16)
		"scanMaxChunks": 8,

		// Commande scan : chunks lus par tick (le scan est reparti sur plusieurs ticks) (1 a 64)
		"scanChunksPerTick": 4,

		// Commande scan : nombre maximum de conteneurs lus par scan (16 a 4096)
		"scanMaxContainers": 1024,

		// Commande scan : duree (secondes) de validite de l'apercu avant [Appliquer] (30 a 900)
		"scanPreviewSeconds": 120,

		// Salles des coffres (menu Stockage) : tous les coffres de la zone entre deux coffres-coins deviennent automatiques ;
		// les trieurs leur donnent une categorie par colonnes (ou rangees) entieres, dans l'ordre des categories ci-dessus,
		// 'Divers' a la fin, le reste en reserve. Nombre maximum de salles par guilde (0 = desactive)
		"maxRooms": 4,

		// Salles des coffres : nombre maximum de coffres automatiques par guilde (en plus de maxChests)
		"maxRoomChests": 192,

		// Salles des coffres : cote maximum (blocs) de la zone entre les deux coins
		"maxRoomSize": 32,

		// Salles des coffres : marge (%) ajoutee a ce que contient une categorie pour choisir son nombre de colonnes
		"roomHeadroomPercent": 25,

		// Salles des coffres : une categorie recoit une colonne de plus quand il reste moins de N emplacements libres dans les siennes
		"roomGrowFreeSlots": 4,

		// Salles des coffres : une categorie sans colonne en recoit une quand elle contient au moins N piles (avant, ses
		// objets vont dans 'Divers' : un objet isole ne fait jamais tout deplacer)
		"roomNewCategoryStacks": 9,

		// Salles des coffres : une colonne vide depuis N minutes revient a la reserve si sa categorie n'en a pas besoin
		"roomIdleMinutes": 30,

		// Salles des coffres : pour qu'une categorie qui grandit reste d'un seul tenant, les blocs de colonnes voisins se
		// decalent d'une colonne s'ils sont au plus N ; au-dela elle prend la colonne libre la plus proche (0 a 20)
		"roomMaxShift": 3,

		// Salles des coffres : intervalle (secondes) entre deux verifications de la repartition des categories
		"roomPlanSeconds": 30
	},

	// Expeditions : le villageois quitte la base (il disparait), puis revient apres la duree indiquee avec du butin.
	// Il part par le bureau d'accueil (ou le coeur) ; pour le Nether, par un portail du Nether DANS le territoire.
	// lossChance = risque (0 a 1) qu'il ne revienne jamais ; rolls = nombre de tirages dans la table de butin.
	"expeditions": {

