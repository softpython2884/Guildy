		// Objectifs prioritaires du mineur ou de la zone : poids multiplie dans les tables de butin (1 = aucun effet)
		"wishlistWeight": 4
	},

	// Tache 'Mineur', mode 'Reel' (zones de mine) : les mineurs creusent vraiment. Depuis le fanion, un escalier en
	// colimacon (2 blocs de large, 3 de haut) descend ; tous les 'levelSpacing' blocs, un niveau : un palier puis une
	// galerie principale avec des galeries laterales tous les 3 blocs (objectif 'Pierre' : des salles de carriere),
	// toujours dans le carre de la zone. Les niveaux s'ouvrent pendant que l'escalier continue de descendre jusqu'a la
	// profondeur cible : plusieurs mineurs (jusqu'a 'maxMinersPerZone') se partagent les chantiers. Les minerais et les
	// objectifs prioritaires visibles sont mines en suivant leurs filons (un peu hors de la zone aussi). Seuls des blocs
	// naturels sont casses (listes ci-dessous) : jamais un bloc pose par un joueur, un bloc a donnees (coffre...), un bloc
	// d'une autre guilde, ni un bloc naturel qui porte un bloc non naturel. L'eau et la lave sont colmatees avec un bloc
	// du sac (sinon la galerie est abandonnee) et les trous du sol combles.
	"realMining": {

		// Mode des nouvelles zones de mine (et des anciennes sans reglage) : true = reel, false = simule
		"defaultReal": true,

		// Temps (ticks, 20 = 1 seconde) pour casser un bloc ; le bonus de vitesse de travail s'applique (4 blocs/s max)
		"ticksPerBlock": 20,

		// Objectif 'Minerais' : profondeur cible par defaut (Y du sol des galeries ; -54 = couche des diamants)
		"oresTargetY": -54,

		// Objectif 'Tout venant' : profondeur cible par defaut (Y)
		"mixedTargetY": 16,

		// Objectif 'Pierre et variantes' : profondeur par defaut des galeries sous le fanion (blocs)
		"stoneDepth": 12,

		// Profondeur minimum des galeries sous le fanion (blocs) : jamais de tranchee a la surface
		"minDepthBelowFanion": 4,

		// Ecart (blocs) entre deux niveaux de galeries (un palier de l'escalier tous les N blocs, du premier niveau sous
		// la surface jusqu'a la profondeur cible) ; aussi le pas des boutons de profondeur du menu de la zone
		"levelSpacing": 6,

		// Escalier arrive a la profondeur cible et tous les niveaux termines (ou des mineurs sans travail) : l'escalier
		// descend ouvrir les niveaux suivants, plus bas (jusqu'au fond du monde)
		"autoNextLevel": true,

		// Cote (blocs) du carre interieur de l'escalier en colimacon (3 a 6) : une marche = 1 bloc plus bas
		"stairSide": 4,

		// Largeur des nouveaux escaliers : 2 = deux voies (les mineurs se croisent sans se gener, le carre fait 2 blocs de
		// plus de cote ; 1 voie si la zone est trop petite), 1 = une voie. Les escaliers deja creuses gardent leur largeur.
		"stairWidth": 2,

		// Nombre maximum de mineurs qui travaillent en meme temps dans une meme mine reelle (menu : affectation refusee au-dela)
		"maxMinersPerZone": 20,

		// Longueur maximum de la galerie principale (blocs ; coupee au bord de la zone)
		"mainTunnelLength": 32,

		// Ecart entre deux galeries laterales (blocs, 2 minimum)
		"branchSpacing": 3,

		// Longueur de chaque galerie laterale (blocs ; coupee au bord de la zone)
		"branchLength": 12,

		// Objectif 'Pierre' : largeur des salles de carriere (blocs, impair)
		"roomWidth": 5,

		// Objectif 'Pierre' : longueur des salles de carriere (blocs)
		"roomLength": 5,

		// Objectif 'Pierre' : hauteur des salles de carriere (blocs)
		"roomHeight": 3,

		// Objectif 'Pierre' : couloir entre deux salles (blocs)
		"roomGap": 2,

		// Blocs suivis au plus par filon (minerais et objectifs prioritaires visibles depuis les tunnels, sol compris ;
		// 0 = ne pas suivre les filons). Hors de portee : un autre mineur le suit plus tard en creusant un tunnel d'approche.
		"maxVeinBlocks": 64,

		// Distance (blocs) au-dela du bord de la zone jusqu'a laquelle un filon est suivi (jamais chez une autre guilde)
		"veinMaxOutside": 16,

		// Blocs de remplissage (pierre taillee...) gardes dans le sac pour colmater et combler : ils restent dans le sac au
		// coffre de depot (sauf fin de mission). Objectif 'Minerais' : le reste des gravats est laisse sur place.
		"fillerReserve": 32,

		// Une torche toutes les N marches / N blocs de galerie (0 = pas de torche)
		"torchInterval": 8,

		// Les torches utilisent le charbon du sac quand il y en a (1 charbon = 4 torches, + 1 baton s'il y en a)
		"torchesUseCoal": true,

		// Sans charbon dans le sac : torche gratuite (true) ou pas de torche (false)
		"freeTorches": true,

		// Trou dans le sol et aucun bloc de remplissage dans le sac : pierre taillee gratuite (true) ou galerie abandonnee
		"freeFloorBlocks": true,

		// Heure (ticks du jour, 0 a 24000) a partir de laquelle le mineur remonte avant la nuit (-1 = jamais)
		"surfaceAtTime": 10500,

		// Blocs naturels que le mineur peut casser (id ou #tag ; les blocs a donnees ne sont jamais casses)
		"naturalBlocks": [
			"#minecraft:base_stone_overworld",
			"#minecraft:substrate_overworld",
			"#minecraft:sand",
			"minecraft:gravel",
			"minecraft:clay",
			"minecraft:sandstone",
			"minecraft:red_sandstone",
			"minecraft:calcite",
			"minecraft:dripstone_block",
			"minecraft:pointed_dripstone",
			"minecraft:smooth_basalt",
			"minecraft:magma_block",
			"minecraft:snow_block",
			"minecraft:infested_stone",
			"minecraft:infested_deepslate"
		],

		// Minerais (cassables, suivis en filon ; seuls gardes avec l'objectif 'Minerais')
		"oreBlocks": [
			"#minecraft:ores",
			"#minecraft:gold_ores",
			"minecraft:raw_iron_block",
			"minecraft:raw_copper_block"
		],

		// Objets du sac utilisables pour colmater l'eau et la lave et combler les trous (blocs pleins, jamais de sable)
		"fillerItems": [
			"minecraft:cobblestone",
			"minecraft:cobbled_deepslate",
			"minecraft:dirt",
			"minecraft:stone",
			"minecraft:deepslate",
			"minecraft:andesite",
			"minecraft:diorite",
			"minecraft:granite",
			"minecraft:tuff",
			"minecraft:calcite",
			"minecraft:netherrack"
		]
	},

	// Tache 'Bucheron' : coupe reelle des arbres naturels de sa zone (sans zone : les plus proches de lui)
	"lumberjack": {

		// Nombre maximum de buches d'un arbre (les arbres plus grands sont ignores ; 160 : sapins et acajous geants compris)
		"maxLogsPerTree": 160,

		// Replanter une pousse a la base de l'arbre coupe (si le sol le permet)
		"replant": true
	},

	// Tache 'Fermier' : recolte les cultures mures de sa zone (sans zone : les plus proches de lui) et les replante
	"farmer": {

		// Cultures sous abri : hauteur (blocs) au-dessus et en dessous du fanion (sans zone : du villageois)
		// ou les chercher en plus de la surface
		"verticalRange": 3,

		// Nombre maximum de cultures recoltees par seconde
		"harvestPerSecond": 3
	},

	// Tache 'Garde' : patrouille (zone ou parcours) ou defend le coeur ; pendant les vagues, defend toujours le coeur
	"guard": {

		// Rayon (blocs) de surveillance du garde (autour du coeur sans zone, autour de lui en patrouille)
		"radius": 16,

		// Zone de patrouille : marge (blocs) autour de la zone ou le garde attaque encore les monstres
		"zoneMargin": 8,

		// Degats par coup au niveau 1 de la guilde
		"damage": 4.0,

		// Degats supplementaires par niveau de guilde
		"damagePerLevel": 0.5,

		// Delai (ticks, 20 = 1 seconde) entre deux coups
		"attackCooldownTicks": 20,

		// Distance (blocs) a laquelle le garde peut frapper
		"attackReach": 2.5,

		// Abandonner une cible qu'on n'arrive pas a atteindre apres ce delai (secondes)
		"chaseTimeoutSeconds": 20,

		// Monstres ignores par les gardes
		"ignoredMobs": [
			"minecraft:creeper",
			"minecraft:phantom",
			"minecraft:ghast",
			"minecraft:enderman"
		],

		// Roles : epeiste (corps a corps) ou archer (fleches). Role 'Auto' (par defaut, modifiable dans le menu du garde) :
		// le role qui rapproche la part d'archers parmi les gardes de la guilde de cette valeur (0 = que des epeistes,
		// 1 = que des archers, 0.5 = moitie-moitie)
		"archerShare": 0.5,

		// Archers : portee maximum de tir (blocs ; il faut voir le monstre)
		"bowRange": 16,

		// Archers : en dessous de cette distance (blocs), l'archer recule pour garder ses distances
		"bowMinDistance": 5.0,

		// Archers : degats d'une fleche = degats d'un coup d'epee (damage, damagePerLevel, arbre d'evolution) x ce facteur
		"bowDamageFactor": 1.0,

		// Archers : delai (ticks, 20 = 1 seconde) entre deux tirs
		"bowCooldownTicks": 30,

		// Archers : imprecision des tirs (0 = parfait ; un squelette en difficulte difficile = 2)
		"bowInaccuracy": 2.0,

		// Monstres ignores par les archers (liste a part : ils peuvent tirer sur des monstres que les epeistes ne
		// peuvent pas atteindre, comme les phantoms). Leurs fleches ne touchent que les monstres : jamais un joueur,
		// un villageois, un animal de compagnie ou un animal passif.
		"bowIgnoredMobs": [
			"minecraft:creeper",
			"minecraft:enderman"
		],

		// Repli : sous cette part de sa vie (0 a 1, 0 = jamais), le garde arrete de combattre et court (bonus de vitesse)
		// se soigner a son lit (sinon le lit le plus proche du territoire, sinon le bureau d'accueil ou le coeur), meme
		// pendant une horde. Il frappe encore les monstres a portee de bras en chemin.
		"retreatHealthRatio": 0.4,

		// Repli : le garde reprend son poste (patrouille, parcours, defense du coeur) une fois soigne a cette part de sa vie
		"resumeHealthRatio": 0.9,

		// Soin pendant le repli, loin d'un lit (points de vie par seconde ; 2 points = 1 coeur, un villageois en a 20)
		"healPerSecond": 0.5,

		// Soin a cote de son lit (points de vie par seconde)
		"bedHealPerSecond": 1.0,

		// Regeneration lente hors combat (points de vie par seconde, 0 = aucune ; les villageois ne regenerent pas seuls)
		"passiveRegenPerSecond": 0.1,

		// Repli : niveau de l'effet Vitesse pendant la course vers le lit (0 = aucun, 2 = Vitesse II)
		"retreatSpeedLevel": 2,

		// Equipement : hors combat, les gardes vont prendre les meilleures pieces d'armure (points d'armure, puis
		// robustesse ; toute matiere, enchantees ou non) dans les coffres du stockage enregistres (menu Villageois ->
		// Stockage : depot et categories) et rapportent l'ancienne piece. Une piece cassee est remplacee plus tard.
		"equipmentFromChests": true,

		// Equipement : les gardes prennent aussi une meilleure epee (epeistes) ou un meilleur arc enchante (archers)
		"weaponsFromChests": true,

		// Equipement : intervalle (secondes) entre deux recherches d'equipement dans les coffres
		"equipmentScanSeconds": 30,

		// Equipement : les armures des gardes s'usent quand ils sont blesses (comme celles des joueurs)
		"armorWear": true,

		// Equipement : a la mort d'un garde, son equipement (armure, arme des coffres) tombe au sol (false = perdu avec lui)
		"dropEquipmentOnDeath": true
	},

	// Stockage de la guilde (coffres de depot et coffres par categorie)
	"storage": {

		// Categories de rangement (ordre du fichier = ordre des menus) : "Nom": { icon, description, rules }.
		//   icon : objet affiche dans les menus ; description : exemples affiches dans les menus ;
		//   rules : regles qui designent les objets de la categorie (espace de noms facultatif, majuscules ignorees) :
		//     minecraft:diamond      un objet precis
		//     #minecraft:logs        un tag d'objets (vanilla ou c: des tags communs Fabric)
		//     *_ore, stripped_*      un motif d'id (* = n'importe quel texte ; sans espace de noms : tous les mods)
		//     @food @armor @tool @weapon @potion @enchanted_book @enchanted @music_disc @banner_pattern
		//     @smithing_template @spawn_egg @dye @block      une propriete de l'objet
		//     @tab:building_blocks   un onglet de l'inventaire creatif (building_blocks, colored_blocks, natural_blocks,
		//                            functional_blocks, redstone_blocks, tools_and_utilities, combat, food_and_drinks,
		//                            ingredients, spawn_eggs)
		// La regle la plus precise l'emporte : objet precis, puis tag (le plus petit d'abord), puis motif (le plus long
		// d'abord), puis propriete, puis onglet ; a egalite, la premiere categorie du fichier. Aucune regle : 'Divers'.
		// Chevauchements des categories par defaut : le butin de monstres est liste objet par objet, il gagne donc sur
		// Nourriture, Nether et End (chair putrefiee, yeux d'araignee, batons de blaze, larmes de ghast, carapaces de
		// shulker, tetes et cranes...) ; les fleches (meme a effet) vont dans Armes ; chorus et pierre de l'End dans End ;
		// quartz, roche noire et basalte dans Nether, mais les minerais du Nether dans Minerais et le bois du Nether dans
		// Bois ; boutons, plaques de pression et rails dans Redstone ; dalles, escaliers et murets suivent leur matiere
		// (pierre, bois, Nether, End...), sinon Blocs de construction. Un coffre dont la categorie n'existe plus sert de
		// coffre 'Divers'.
