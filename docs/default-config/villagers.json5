	// Tache 'Forgeron' : repare peu a peu l'equipement abime (armures et objets en main) pose sur les porte-armures du
	// territoire, a l'enclume la plus proche du porte-armure ; chaque etape use l'enclume comme en vanilla
	"blacksmith": {

		// Niveau de guilde minimum pour donner cette tache a un villageois (1 a 100)
		"minGuildLevel": 3,

		// Distance maximum (blocs) entre un porte-armure et l'enclume utilisee (la plus proche, dans le territoire) ;
		// un porte-armure sans enclume assez proche est ignore (2 a 32)
		"anvilRadius": 12,

		// Temps de travail (secondes) pour une etape de reparation ; le bonus de vitesse de travail s'applique (1 a 600)
		"secondsPerRepair": 8,

		// Durabilite rendue a chaque etape, en pourcentage de la durabilite maximum de l'objet (1 a 100). L'objet le plus
		// abime du porte-armure (plus petite part de durabilite restante) passe en premier ; il reste toujours sur le porte-armure
		"repairPercent": 10,

		// Chaque etape est une utilisation de l'enclume : chance (0 a 1) de l'abimer d'un cran comme en vanilla (0.12) :
		// enclume -> ebrechee -> endommagee -> detruite. Detruite : le forgeron cherche une autre enclume
		"anvilDamageChance": 0.12,

		// Intervalle minimum (secondes) entre deux recherches des porte-armures du territoire (5 a 600)
		"scanIntervalSeconds": 30
	},

	// Tache 'Alchimiste' : avec une table d'enchantement du territoire (celle qui a le plus de bibliotheques), du temps
	// et des livres (sac puis coffres du stockage), il fabrique des livres enchantes ranges dans le stockage
	"alchemist": {

		// Niveau de guilde minimum pour donner cette tache a un villageois (1 a 100)
		"minGuildLevel": 5,

		// Temps de travail (secondes) par niveau d'enchantement : un livre de niveau 30 prend 30 x cette valeur ; le bonus
		// de vitesse de travail s'applique (1 a 120). Le niveau suit la 3e ligne de la table vanilla selon le nombre de
		// bibliotheques (15 bibliotheques : niveau 30 ; table seule : niveau 1 a 8)
		"secondsPerLevel": 6,

		// Livres enchantes (et parchemins) au plus par alchimiste et par jour de jeu (1 a 1000)
		"maxBooksPerDay": 8,

		// Lapis-lazuli consomme par livre (0 a 3) ; 0 = seulement du temps et des livres. Pris dans son sac puis dans les
		// coffres du stockage, comme les livres
		"lapisPerBook": 0,

		// Livres pris dans les coffres du stockage en un voyage (1 a 64)
		"booksPerTrip": 4,

		// Intervalle minimum (secondes) entre deux recherches des tables d'enchantement du territoire (10 a 3600)
		"scanIntervalSeconds": 120,

		// Chance (0 a 1) qu'un travail termine donne un parchemin de sort au lieu d'un livre enchante (0 = jamais). Le
		// parchemin utilise le meme livre (et le lapis) plus scrollPaper feuilles de papier ; sans papier : un livre enchante.
		// Il est range dans le coffre de sa categorie de stockage (sinon un coffre Divers, sinon un coffre de depot)
		"scrollChance": 0.15,

		// Feuilles de papier par parchemin (0 a 64), prises dans son sac puis dans les coffres du stockage comme les livres
		"scrollPaper": 2,

		// Parchemins au plus par alchimiste et par jour de jeu, compris dans maxBooksPerDay (0 a maxBooksPerDay ; 0 = jamais)
		"maxScrollsPerDay": 2,

		// Niveau d'enchantement minimum (1 a 30) pour ecrire un parchemin plus rare que RARE (EPIC, LEGENDARY, MYTHIC) ; en
		// dessous, seuls les parchemins RARE sont possibles. Niveau 30 = table entouree de 15 bibliotheques
		"epicScrollLevel": 30,

		// Parchemins que l'alchimiste peut ecrire : {id: poids} (ids de scrolls.json5, tirage pondere parmi ceux permis au
		// niveau du travail ; un id inconnu est ignore avec un avertissement dans les journaux du serveur)
		"scrolls": {
			"rappel": 12.0,
			"benediction": 7.0,
			"revelation": 6.0,
			"blizzard": 1.0,
			"seisme": 1.0,
			"egide": 1.0,
			"tempete_de_foudre": 1.0
		}
	},

	// Chargement des chunks : les villageois au travail gardent leurs chunks actifs pour continuer sans joueur a
	// proximite (tickets vanilla non sauvegardes, renouveles toutes les quelques secondes, qui expirent seuls) : autour
	// d'eux, de leur destination (coffre de depot ou de stockage, lit a la tombee de la nuit, retour d'expedition) et de
	// leur zone de travail. Rien pour les villageois sans tache, en expedition ou couches (ni pour les gardes par defaut).
	// Dans ces chunks les cultures et les pousses grandissent (ticks aleatoires), mais aucun monstre n'apparait : les
	// apparitions naturelles n'ont lieu qu'a moins de 128 blocs d'un joueur.
	// Mode 'always' : mettez pause-when-empty-seconds=0 dans server.properties, sinon le serveur se met en pause sans
	// joueur connecte (apres 60 secondes par defaut) et plus rien ne tourne. Etat : /guild admin villager chunks
	"chunkLoading": {

		// Quand garder les chunks actifs : "online" = tant qu'au moins un membre de la guilde est connecte (par defaut),
		// "always" = toujours, meme sans aucun joueur connecte, "never" = jamais (les villageois ne travaillent que pres des joueurs)
		"mode": "online",

		// Rayon (chunks) maintenu actif autour de chaque villageois au travail et de sa destination : 0 = son chunk, 1 = 3x3 (0 a 3)
		"radius": 1,

		// Rayon maximum (chunks) maintenu actif autour du fanion de la zone de travail (le rayon de la zone, plafonne a cette
		// valeur) ou, sans zone, du point du territoire le plus proche (bucheron, fermier) ; 0 a 5
		"zoneRadius": 2,

		// Nombre maximum de chunks maintenus actifs par guilde (0 a 1024) : les villageois eux-memes d'abord (les plus proches
		// du coeur en premier), puis leurs destinations, leurs zones, enfin les coffres du rangement
		"maxChunksPerGuild": 64,

		// Nombre maximum de chunks maintenus actifs sur tout le serveur, toutes guildes confondues, servies a tour de role (0 a 8192)
		"maxChunksTotal": 512,

		// Intervalle (secondes) entre deux mises a jour des tickets (1 a 5) ; un ticket qui n'est plus renouvele expire seul
		// apres 10 secondes
		"refreshSeconds": 2,

		// A la tombee de la nuit, duree (secondes) pendant laquelle un villageois qui rentre a son lit garde ses chunks
		// actifs (0 = aucune, jusqu'a 600) ; couche, il ne charge plus rien jusqu'au matin
		"bedTravelSeconds": 90,

		// Garder aussi actifs les chunks des gardes (inutile en general : aucun monstre n'apparait loin des joueurs)
		"guards": false
	},

	// Chance (0 a 1) que chaque villageois quitte la guilde apres une vague perdue
	"defeatLeaveChance": 0.2,

	// Prenoms donnes aux villageois qui se presentent
	"names": [
		"Albert",
