// Guildy - villageois de guilde : arrivees, taches, zones de travail, parcours de garde, stockage.
// Les villageois arrivent au bureau d'accueil (construction 'reception'), puis travaillent pour la guilde.
// Rechargement a chaud : /guild admin reload
{

	// Version du fichier (geree automatiquement, ne pas modifier)
	"configVersion": 7,

	// Arrivees de nouveaux villageois
	"arrivals": {

		// Nombre maximum de villageois au niveau 1 de la guilde
		"baseMaxVillagers": 2,

		// Villageois supplementaires autorises par niveau de guilde, jusqu'au niveau 10
		"maxVillagersPerLevel": 1,

		// Au-dela du niveau 10 : villageois supplementaires par niveau (0.1 = un tous les 10 niveaux). 0 par defaut : les
		// places suivantes viennent des paliers de niveau (config.json5, levels.rewards.villagerSlotEvery)
		"maxVillagersPerLevelAbove10": 0.0,

		// Chance (0 a 1) qu'un villageois se presente chaque matin (si les conditions sont reunies)
		"arrivalChance": 0.6,

		// Delai (secondes) avant le premier candidat apres la construction du bureau d'accueil
		"firstArrivalDelaySeconds": 60,

		// Duree (secondes) pendant laquelle un candidat attend une reponse avant de repartir
		"candidateTimeoutSeconds": 600,

		// Exiger au moins un lit libre dans le territoire pour qu'un villageois se presente
		"requireFreeBed": true,

		// Nombre de candidats qui se presentent ensemble : tire entre groupMin et groupMax, dans la limite des
		// places libres, des lits libres et de maxCandidates (candidats en attente en meme temps, 1 a 5)
		"groupMin": 1,
		"groupMax": 3,
		"maxCandidates": 3
	},

	// Reglages communs a toutes les taches
	"work": {

		// Nombre de piles d'objets qu'un travailleur (mineur, bucheron, fermier) transporte avant d'aller deposer
		"carryStacks": 9,

		// Temps maximum (secondes) pour atteindre une destination ; ensuite le villageois est teleporte a cote
		"walkTimeoutSeconds": 40,

		// Temps (secondes) sans progresser avant de considerer le villageois bloque (meme solution)
		"stuckSeconds": 12,

		// Intervalle minimum (secondes) entre deux recherches d'arbres / de cultures
		"scanIntervalSeconds": 10,

		// Vitesse de marche des villageois au travail (multiplicateur, vanilla = 0.5)
		"walkSpeed": 0.6
	},

	// Tache 'Ranger la base' : vide les coffres de depot dans les coffres par categorie, puis re-range les coffres
	"sorter": {

		// Intervalle (secondes) entre deux verifications des coffres de depot
		"intervalSeconds": 10,

		// Nombre de piles d'objets emportees a chaque voyage
		"stacksPerTrip": 6,

		// Temps maximum (secondes) pour atteindre un coffre avant teleportation
		"walkTimeoutSeconds": 30,

		// Re-ranger les coffres quand les depots sont vides : les coffres d'une meme categorie forment un groupe (par salle
		// des coffres), range comme un mur qu'on lit (voir storage.defaultOrder) : objets d'une autre categorie sortis, piles
		// fusionnees, ordre de l'inventaire creatif, coffre 1 rempli avant le coffre 2...
		"tidy": true,

		// Pause (secondes) avant de reverifier les groupes quand tout est range
		"tidyIntervalSeconds": 15,

		// Nombre maximum de coffres verifies par seconde (un groupe plus grand est verifie seul)
		"auditChestsPerStep": 16,

		// Portee (blocs) d'une position de travail : les coffres consecutifs d'un groupe a moins de cette distance du centre
		// de leur ensemble (une colonne, un pan de mur) sont reorganises d'un coup sur place ; entre deux pans eloignes, le
		// trieur porte les piles d'un coffre a l'autre (2 a 8)
		"reach": 5,

		// Nombre maximum de coffres reorganises d'un coup sur place (1 a 64)
		"maxChestsPerStep": 16,

		// Duree (secondes) de la reservation d'un groupe par un trieur : deux trieurs ne rangent jamais le meme groupe a la fois
		"leaseSeconds": 20,

		// Animation du rangement : couvercles des coffres ouverts puis refermes, bras et sons
		"animation": true
	},

	// Zones de travail : chaque zone est marquee par un fanion (menu Villageois -> Zones et parcours).
	// Types : mine, coupe de bois, champs, patrouille. Une zone peut sortir du territoire, jamais entrer dans celui
	// d'une autre guilde. Rayon en chunks autour du chunk du fanion : 0 = son chunk, 1 = 3x3 chunks, 2 = 5x5...
	"zones": {

		// Nombre maximum de zones de travail par guilde (1 a 27)
		"maxZones": 12,

		// Rayon maximum d'une zone, en chunks (0 a 5)
		"maxRadiusChunks": 3,

		// Rayon d'une nouvelle zone, en chunks
		"defaultRadiusChunks": 1,

		// Distance maximum (blocs) entre le coeur et un fanion de zone ou un point de parcours
		"maxZoneDistance": 192,

		// Mode automatique (aucune zone choisie) : rayon (blocs) de recherche, toujours a moins de maxZoneDistance du coeur.
		// Bucheron et fermier : autour du point du territoire le plus proche d'eux (autour d'eux dans le territoire), donc
		// jamais plus loin que ce rayon du territoire ; mineur (pierre a decouvert) : autour de lui
		"autoSearchRadius": 48,

		// Objectifs prioritaires (menu d'un villageois ou d'une zone) : distance (blocs) hors de la zone (ou de la zone
		// automatique) jusqu'ou un bucheron ou un fermier va chercher les objets voulus ; jamais chez une autre guilde (0 a 64)
		"wishlistMargin": 16,

		// Duree (secondes) d'affichage des limites d'une zone ou d'un parcours (bouton 'Afficher')
		"showSeconds": 20
	},

	// Parcours de garde : suite de points (clic droit) que les gardes parcourent en boucle ou en aller-retour
	"routes": {

		// Nombre maximum de parcours de garde par guilde (0 a 9, 0 = desactive)
		"maxRoutes": 6,

		// Nombre maximum de points par parcours
		"maxWaypoints": 16,

		// Pause (secondes) du garde a chaque point (parcours et zones de patrouille)
		"pauseSeconds": 4,

		// Distance maximum (blocs) entre le parcours et un monstre que le garde poursuit
		"leash": 16,

		// Creation d'un parcours : annulee apres ce delai (secondes) sans nouveau point
		"selectionTimeoutSeconds": 120
	},

	// Tache 'Mineur', mode 'Simule' : minage simule au fanion de sa zone, le butin depend de l'objectif de la zone et
	// de la profondeur (Y) du fanion. Sans zone : la mine la plus proche, sinon la pierre naturelle a decouvert la plus proche.
	"miner": {

		// Duree (secondes) d'une expedition de minage a la mine
		"tripSeconds": 120,

		// Intervalle (secondes) entre deux animations de minage
		"effectIntervalSeconds": 3,

		// Objectif 'Tout venant' : nombre de tirages dans la table de butin a la fin de chaque expedition
		"rollsPerTrip": 5,

		// Objectif 'Tout venant' (pierre + minerais) : tables de butin par profondeur. La premiere table dont
		// maxY >= Y du fanion est utilisee (au-dessus de toutes : la derniere).
