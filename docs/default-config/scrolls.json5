// Guildy - parchemins de sort : objets a usage unique qui lancent un sort tres puissant (clic droit maintenu).
// Ils tombent des boss des ruines (surtout), des boss des hordes, des quetes, des expeditions des villageois et se
// vendent parfois au Carrefour commercial. Les sorts ne blessent que les monstres et ne modifient aucun bloc.
// Le grimoire (section grimoire) relie jusqu'a 4 parchemins et relance leurs sorts contre de la nourriture ; le grimoire
// maudit (section cursedGrimoire) fait de meme avec des sorts bien plus puissants, contre plus de faim et un peu de sang.
// Commandes admin : /guild admin scroll list | give <joueur> <id> [nombre] | grimoire <joueur> [cursed] [ids].
{

	// Version du fichier (geree automatiquement, ne pas modifier)
	"configVersion": 3,

	// Parchemins actifs (false = ils ne lancent plus rien, ils ne sont pas consommes)
	"enabled": true,

	// Butin : les parchemins tombent des boss, des quetes, des expeditions et se vendent au Carrefour (false = plus aucun)
	"dropsEnabled": true,

	// Incantation (clic droit maintenu)
	"casting": {

		// Vitesse de deplacement pendant l'incantation (0 a 1 ; manger = 0.2)
		"moveSpeed": 0.35,

		// Dimensions ou les parchemins ne fonctionnent pas (ex. "minecraft:the_end")
		"disabledDimensions": [],

		// En creatif le parchemin n'est jamais consomme ; true = la recharge s'applique quand meme
		"creativeCooldown": true
	},

	// Limites des effets en cours (performances)
	"limits": {

		// Sorts actifs en meme temps par joueur (au-dela, le parchemin n'est pas utilise)
		"maxEffectsPerPlayer": 3,

		// Sorts actifs en meme temps sur tout le serveur
		"maxEffectsServer": 40,

		// Particules envoyees par tick, tous sorts confondus (au-dela, l'animation est allegee ; les effets restent)
		"particleBudget": 2500,

		// Distance (blocs) a laquelle les joueurs voient les animations (particules longue distance)
		"viewDistance": 96,

		// Gardiens (golems invoques) vivants en meme temps par joueur
		"maxGuardiansPerPlayer": 4
	},

	// Vente au Carrefour commercial (table "trade" : chance qu'un marchand du Carrefour propose un parchemin, un seul achat)
	"trade": {

		// Prix (or) d'un parchemin au Carrefour selon sa rarete
		"prices": {
			"RARE": 40,
			"EPIC": 80,
			"LEGENDARY": 150,
			"MYTHIC": 250
		},

		// Palier minimum du Carrefour pour vendre un parchemin de cette rarete
		"minTiers": {
			"RARE": 2,
			"EPIC": 2,
			"LEGENDARY": 3,
			"MYTHIC": 3
		}
	},

	// Grimoire : un livre qui relie jusqu'a 4 parchemins (clic droit d'un parchemin sur le grimoire dans l'inventaire :
	// le parchemin est consomme et devient une page). Clic droit = lancer le sort de la page choisie (meme visee, meme
	// animation que le parchemin), accroupi + clic droit = page suivante, accroupi + touche d'echange de main (F) ou
	// /guild grimoire = gerer les pages. Rien n'est consomme : chaque sort coute de la nourriture.
	"grimoire": {

		// Grimoire actif (false = il ne lance plus rien et n'est plus obtenu ; ses pages sont conservees)
		"enabled": true,

		// Objet vanilla de base (simple, sans utilisation propre ; livre enchante par defaut)
		"item": "minecraft:enchanted_book",

		// Brillance
		"glint": true,

		// Duree minimale de l'incantation (secondes, 0.05 a 5) : le cercle runique a le temps de se dessiner sous le
		// lanceur. Jamais plus longue que celle du parchemin lui-meme (0.75 a 4 s par defaut)
		"channelSeconds": 1.0,

		// Part de la duree d'incantation du parchemin (0 a 1) : un sort long reste plus long a lire dans le grimoire
		// (ex. 0.6 : Singularite 2 s -> 1.2 s, Rappel 4 s -> 2.4 s ; les sorts courts prennent la duree minimale)
		"channelFactor": 0.6,

		// Animation de l'incantation (toot_horn, spyglass, bow, trident, brush, block...)
		"animation": "toot_horn",

		// Recharge entre deux sorts (secondes, 0.05 a 600) : propre au grimoire (partagee par les grimoires d'un joueur),
		// independante des recharges des parchemins
		"cooldownSeconds": 3.0,

		// Multiplicateur des degats, soins et durees des sorts lances avec le grimoire (0.1 a 5 ; 1 = comme le parchemin)
		"powerMultiplier": 1.0,

		// Cout d'un sort en points de faim (0 a 20 ; la barre en compte 20) selon la rarete du parchemin : la saturation
		// part d'abord, puis la faim. Si la barre de faim est plus basse que le cout, le sort ne part pas. Creatif : gratuit
		"foodCost": {
			"RARE": 3,
			"EPIC": 5,
			"LEGENDARY": 7,
			"MYTHIC": 10
		},

		// Chance (0 a 1) qu'une source donne un grimoire vierge a la place de son tirage de parchemins (memes sources
		// que drops ; trade = un marchand du Carrefour le propose, a partir du palier tradeMinTier)
		"drops": {
			"ruin_boss": 0.08,
			"nether_ruin_boss": 0.12,
			"legendary_quest": 0.04,
			"trade": 0.05
		},

		// Prix (or) du grimoire au Carrefour commercial
		"tradePrice": 400,

		// Palier minimum du Carrefour pour proposer le grimoire
		"tradeMinTier": 3,

		// Texture du pack de ressources (vide = apparence vanilla ; suit le reglage customModels d'uniques.json5)
		"model": "grimoire"
	},

	// Grimoire maudit : memes regles que le grimoire (4 pages reliees depuis des parchemins, clic droit = lancer, accroupi +
	// clic droit = page suivante, accroupi + F = les pages ; incantation de la section grimoire) mais ses sorts sont bien
	// plus puissants : plus de degats, de duree, de portee, de cibles, de meteores... Prix : plus de faim, un peu de sang
	// (points de vie, jamais en dessous de minHealth : sinon le sort est refuse) et une recharge plus longue. Creatif : gratuit.
	// Il ne tombe que du gardien MAUDIT des ruines de ruinDrops (l'Archimage dechu de la Tour du Mage par defaut).
	"cursedGrimoire": {

		// Grimoire maudit actif (false = il ne lance plus rien et ne tombe plus ; ses pages sont conservees)
		"enabled": true,

		// Objet vanilla de base (simple, sans utilisation propre ; livre enchante par defaut)
		"item": "minecraft:enchanted_book",

		// Brillance
		"glint": true,

		// Multiplicateur des degats, soins et durees des sorts (0.1 a 5 ; 1 = comme le parchemin)
		"powerMultiplier": 1.75,

		// Multiplicateur des portees et des rayons (0.1 a 3)
		"radiusMultiplier": 1.35,

		// Multiplicateur des nombres : meteores, monstres foudroyes, ondes, golems, allies rappeles (0.1 a 5, arrondi)
		"countMultiplier": 1.5,

		// Niveaux d'effet en plus : Lenteur, Absorption, Resistance, Regeneration (0 a 3)
		"levelBonus": 1,

		// Reglages par sort (id du sort, voir spell des parchemins) : {parametre: multiplicateur} remplace le multiplicateur
		// general de ce parametre (niveaux : multiplies puis arrondis ; 0.1 a 5). Bornes : les nombres et les niveaux ne
		// depassent jamais le maximum du parametre, les portees et forces 1.5 fois ce maximum, les degats et durees 5 fois
		"spells": {
			"meteor_shower": {
				"count": 2.5,
				"radius": 1.6,
				"impactRadius": 1.3
			},
			"chain_storm": {
				"count": 2.5,
				"chainRadius": 1.5
			},
			"solar_nova": {
				"knockback": 1.3
			},
			"singularity": {
				"radius": 1.6,
				"pullStrength": 1.4
			},
			"aegis": {
				"push": 1.3
			},
			"revelation": {
				"radius": 1.25
			},
			"earthquake": {
				"waves": 1.67,
				"lift": 1.3
			},
			"arcane_ray": {
				"width": 1.5
			}
		},

		// Recharge entre deux sorts (secondes, 0.05 a 600) : propre au grimoire maudit, un peu plus longue que celle du grimoire
		"cooldownSeconds": 5.0,

		// Cout d'un sort en points de faim (0 a 20) selon la rarete du parchemin (saturation d'abord, refus si la faim est plus basse)
		"foodCost": {
			"RARE": 4,
			"EPIC": 7,
			"LEGENDARY": 9,
			"MYTHIC": 12
		},

		// Prix du sang : points de vie pris a chaque sort selon la rarete (0 a 20 ; 2 = 1 coeur)
		"bloodCost": {
			"RARE": 1,
			"EPIC": 1,
			"LEGENDARY": 2,
			"MYTHIC": 2
		},

		// Vie minimale apres le prix du sang (points de vie, 1 a 19) : en dessous, le sort est refuse
		"minHealth": 6.0,

		// Chance (0 a 1) que le gardien MAUDIT d'une ruine (id de ruins.json5) laisse un grimoire maudit vierge a sa mort
		// definitive (forme finale). Aucune autre source : ni les gardiens normaux, ni les quetes, ni le Carrefour
		"ruinDrops": {
			"tour_du_mage": 0.1
		},

		// Texture du pack de ressources (vide = apparence vanilla ; suit le reglage customModels d'uniques.json5)
		"model": "grimoire_maudit"
	},

	// Tables de butin par source : chance (0 a 1) qu'un parchemin tombe, min/max (nombre de parchemins), puis tirage
	// pondere dans items {id: poids}. Sources : ruin_boss et nether_ruin_boss (boss des ruines : les meilleurs
	// parchemins), boss (boss des hordes), blood_boss (boss d'une nuit de sang), legendary_quest (quete legendaire),
	// quest (recompense de quete, rare), expedition (expeditions des villageois), trade (marchand du Carrefour commercial).
	"drops": {
		"ruin_boss": {
			"chance": 0.6,
