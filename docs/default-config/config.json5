// Guildy - configuration principale (guildes, territoire, protection, economie, niveaux).
// Les autres fichiers de ce dossier configurent les vagues, quetes, boutique, constructions et villageois.
// Rechargement a chaud : /guild admin reload   (les commentaires sont regeneres automatiquement)
{

	// Version du fichier (geree automatiquement, ne pas modifier)
	"configVersion": 3,

	// Regles des guildes
	"guilds": {

		// Longueur minimale / maximale du nom de guilde
		"nameMinLength": 3,
		"nameMaxLength": 16,

		// Nombre maximum de membres par guilde (0 = illimite)
		"maxMembers": 20,

		// Duree de validite d'une invitation (secondes)
		"inviteExpireSeconds": 300,

		// Activer /guild home
		"homeEnabled": true,

		// Delai entre deux /guild home (secondes)
		"homeCooldownSeconds": 60,

		// Temps d'immobilite avant la teleportation (secondes, 0 = instantane)
		"homeWarmupSeconds": 3
	},

	// Territoire, drapeaux et claims (en chunks de 16x16)
	"territory": {

		// Dimension ou les territoires peuvent exister
		"dimension": "minecraft:overworld",

		// Rayon (en chunks) claim par le drapeau fondateur : 1 => carre 3x3 = 9 chunks
		"foundingRadius": 1,

		// Rayon claim par un drapeau d'extension : 0 => 1 chunk, 1 => 3x3
		"extensionRadius": 0,

		// Les nouveaux chunks doivent toucher (4 voisins) le territoire existant
		"requireConnected": true,

		// Ecart minimum (en chunks) entre les territoires de deux guildes differentes
		"minDistanceBetweenGuilds": 3,

		// Distance minimale (en chunks) entre un territoire et le spawn du monde
		"minDistanceFromSpawn": 4,

		// Nombre maximum de chunks au niveau 1
		"baseMaxChunks": 12,

		// Chunks supplementaires autorises par niveau de guilde, jusqu'au niveau 10
		"maxChunksPerLevel": 6,

		// Au-dela du niveau 10 : chunks supplementaires par niveau, au plus maxChunksAbove10 en tout pour ces niveaux
		// (0 = sans plafond). Par defaut : 66 chunks au niveau 10, 156 au niveau 100, 256 au plus
		"maxChunksPerLevelAbove10": 1,
		"maxChunksAbove10": 190,

		// Prix (or, paye par le tresor) du premier drapeau d'extension
		"extensionFlagBasePrice": 8,

		// Augmentation du prix pour chaque drapeau d'extension deja achete
		"extensionFlagPriceStep": 4,

		// Prix maximum d'un drapeau d'extension
		"extensionFlagMaxPrice": 64,

		// Afficher un titre (true) ou seulement la barre d'action (false) en entrant dans un territoire
		"enterTitle": true,

		// Duree d'affichage des limites du territoire avec /guild show (secondes)
		"borderDisplaySeconds": 45
	},

	// Protection des territoires
	"protection": {

		// Empecher les explosions de detruire des blocs dans les territoires
		"explosions": true,

		// Empecher le feu de detruire des blocs dans les territoires
		"fire": true,

		// Empecher les pistons de deplacer des blocs a travers une frontiere de territoire
		"pistons": true,

		// Empecher les liquides venant de l'exterieur de couler dans un territoire
		"fluids": true,

		// Proteger les entites (animaux, villageois, cadres, supports d'armure) contre les non-membres
		"entities": true,

		// Les non-membres peuvent ouvrir portes/portillons/trappes dans un territoire
		"visitorsCanUseDoors": false
	},

	// Economie : l'or (lingot vanilla) est la monnaie. 1 or = 1 lingot d'or.
	"economy": {

		// Prix (or du tresor) d'une banniere decorative aux couleurs de la guilde
		"decorativeBannerPrice": 2,

		// Or dans le tresor a la creation d'une guilde
		"startingTreasury": 0,

		// Accepter les pepites (9 = 1 or) lors des depots au tresor
		"depositNuggets": true
	},

	// Niveaux de guilde (XP gagnee via vagues et quetes)
	"levels": {

		// Niveau maximum des guildes (10 a 500)
		"maxLevel": 100,

		// XP totale requise pour atteindre chaque niveau de la liste (index 0 = niveau 2, etc.) ;
		// les niveaux suivants, jusqu'a maxLevel, suivent la formule xpStepBase / xpStepGrowth
		"xpThresholds": [
			100,
			250,
			450,
			700,
			1000,
			1400,
			1900,
			2500,
			3200
		],

		// Au-dela de la liste : XP pour passer du niveau N-1 au niveau N = xpStepBase + xpStepGrowth x (N - dernier niveau
		// de la liste). Par defaut (liste jusqu'au niveau 10) : 1340 XP pour le niveau 11, 2600 pour le 20, 6800 pour le 50,
		// 13800 pour le 100 ; XP totale : 3200 au niveau 10, 22900 au 20, 166000 au 50, 684500 au 100
		"xpStepBase": 1200,
		"xpStepGrowth": 140,

		// Recompenses des niveaux gagnes au-dela du niveau 10
		"rewards": {

			// Activer les recompenses des niveaux au-dela du niveau 10 (or, paliers, drapeaux, places de villageois)
			"enabled": true,

			// Or verse au tresor a chaque niveau gagne au-dela du niveau 10 = min(goldMax, goldBase + goldPerLevel x (niveau - 10))
			"goldBase": 20,
			"goldPerLevel": 1.0,
			"goldMax": 120,

			// Paliers : tous les 'milestoneEvery' niveaux au-dela du niveau 10 (5 = niveaux 15, 20, 25...) ; 0 = aucun palier
			"milestoneEvery": 5,

			// Or verse au tresor en plus a chaque palier
			"milestoneGold": 100,

			// Drapeaux d'extension offerts a chaque palier (pris gratuitement dans le menu Territoire ou avec /guild flag buy)
			"milestoneFlags": 1,

			// Annoncer les paliers (et les nouveaux rangs) a tout le serveur
			"announceMilestones": true,

			// Places de villageois en plus : une tous les 'villagerSlotEvery' niveaux au-dela du niveau 10 (10 = niveaux 20, 30...),
			// au plus maxVillagerSlots en tout (0 = aucune)
			"villagerSlotEvery": 10,
			"maxVillagerSlots": 10
		},

		// Rangs de guilde : le rang dont 'level' est le plus haut niveau atteint s'affiche dans /guild info, le menu
		// principal et l'annonce de niveau (name : nom affiche, codes couleur &)
		"ranks": [
			{
				"level": 1,
				"name": "&7Novice"
			},
			{
				"level": 10,
				"name": "&6Bronze"
			},
			{
				"level": 20,
				"name": "&fArgent"
			},
			{
				"level": 30,
				"name": "&eOr"
			},
			{
				"level": 40,
				"name": "&3Platine"
			},
			{
				"level": 50,
				"name": "&bDiamant"
			},
			{
				"level": 75,
				"name": "&aÉmeraude"
			},
			{
				"level": 100,
				"name": "&d&lLégendaire"
			},
			{
				"level": 150,
				"name": "&5&lMythique"
			},
			{
				"level": 250,
				"name": "&c&lImmortelle"
			},
			{
				"level": 400,
				"name": "&6&lDivine"
			}
		]
	},

	// Banniere / drapeau de guilde et affichage sur les cartes
	"banners": {

		// false : la banniere se cree au METIER A TISSER avec de vrais colorants (on tisse le drapeau fondateur,
		// ou n'importe quelle banniere puis 'Adopter la banniere en main' dans le menu Banniere).
		// true : editeur gratuit dans le menu en plus (couleurs et motifs sans ressources).
		"freeEditor": false,

		// Afficher le drapeau-coeur des guildes sur les cartes (marqueur de banniere avec le nom de la guilde)
		"heartOnMaps": true,

		// true : toutes les guildes apparaissent sur les cartes ; false : seulement sa propre guilde
		"allGuildsOnMaps": true
	},

	// Role minimum (MEMBER, OFFICER, LEADER) requis pour chaque action de guilde.
	// BUILD=casser/poser, INTERACT=portes/coffres/entites, INVITE, KICK, CLAIM=claims/drapeaux,
	// TREASURY=retirer/depenser le tresor, VILLAGERS=gerer les villageois, STRUCTURES=constructions,
	// BANNER=editer la banniere, SET_HOME, QUESTS=abandonner/relancer des quetes
	"rolePermissions": {
		"BUILD": "MEMBER",
		"INTERACT": "MEMBER",
		"INVITE": "OFFICER",
		"KICK": "OFFICER",
		"CLAIM": "OFFICER",
		"TREASURY": "OFFICER",
		"VILLAGERS": "OFFICER",
		"STRUCTURES": "OFFICER",
		"BANNER": "OFFICER",
		"SET_HOME": "OFFICER",
		"QUESTS": "OFFICER"
	},

	// Divers
	"general": {

		// Sauvegarde automatique des donnees de guildes (minutes, si modifiees)
		"autosaveMinutes": 5,

		// Niveau d'operateur vanilla requis pour les commandes admin si aucun gestionnaire de permissions n'est installe
		"adminOpLevel": 2
	}
}
