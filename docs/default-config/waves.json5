				"weight": 2.0,
				"minDifficulty": 12.0
			},
			{
				"item": "minecraft:enchanted_golden_apple",
				"min": 1,
				"max": 1,
				"weight": 1.0,
				"minDifficulty": 14.0
			}
		]
	},

	// Consequences d'une defaite (integrite du coeur a 0) : la horde est dispersee immediatement,
	// une partie du tresor est perdue et le palier de nuit recule (la difficulte baisse : anti-spirale).
	// Le depart eventuel de villageois est gere par le module villageois. L'equipement des joueurs n'est jamais touche.
	"defeat": {

		// Pourcentage du tresor perdu en cas de defaite
		"treasuryLossPercent": 25,

		// Le palier de nuit recule de N (minimum 0)
		"nightRollback": 2
	},

	// Treve : apres plusieurs defaites d'affilee (hordes de nuit et raids), la base est epargnee quelques nuits
	// pour se relever. Une victoire remet le compte des defaites a zero.
	"truce": {

		// Activer la treve
		"enabled": true,

		// Nombre de defaites d'affilee qui declenchent une treve (1 a 10)
		"defeatsInARow": 2,

		// Nombre de nuits sans horde pendant la treve (0 a 30)
		"nights": 3,

		// Pendant la treve, les pillards ne lancent pas de raid non plus
		"blocksRaids": true
	},

	// Butin supplementaire lache par les monstres de la horde a leur mort
	"killLoot": {

		// Pepites d'or : chance par monstre ; quantite entre nuggetMin et nuggetMaxBase + nuggetsPerDifficulty * D
		"nuggetChance": 0.6,
		"nuggetMin": 1,
		"nuggetMaxBase": 2,
		"nuggetsPerDifficulty": 0.25,

		// Elites : lingots d'or (min-max) + un objet de la table eliteItems
		"eliteGoldMin": 1,
