// Guildy - hordes nocturnes : chaque nuit, une horde attaque les bases des guildes presentes.
// Heure du jour = horloge de l'Overworld modulo 24000 (13000 = tombee de la nuit, 23000 = aube).
// Victoire : survivre jusqu'a l'aube avec un coeur intact. Defaite : integrite du coeur a 0.
// Rechargement a chaud : /guild admin reload
{

	// Version du fichier (geree automatiquement, ne pas modifier)
	"configVersion": 2,

	// Activer les hordes nocturnes
	"enabled": true,

	// Horaires et conditions de declenchement
	"timing": {

		// Debut de la nuit (heure du jour en ticks)
		"nightStart": 13000,

		// Aube : fin de la nuit et de la horde (victoire si le coeur tient)
		"nightEnd": 23000,

		// Si personne n'est present a la tombee de la nuit, nouvelle tentative jusqu'a cette heure ; jamais apres
		"lateStartUntil": 18000,

		// Intervalle entre deux tentatives de demarrage (secondes)
		"startRetrySeconds": 5,

		// Distance (blocs) au coeur a laquelle un membre en ligne doit se trouver pour declencher la horde
		"activationDistance": 96,

		// Annuler la horde (sans recompense ni penalite) si aucun membre n'est present pendant ce temps (secondes)
		"absentCancelSeconds": 120,

		// Un saut d'horloge superieur a ce nombre de ticks en une seconde (sommeil, /time set) annule la horde
		"maxClockJumpTicks": 600,

		// Terminer la horde par une victoire des que tous ses monstres ont ete tues (sinon attendre l'aube)
		"endWhenHordeDefeated": true,

		// Securite : duree maximale d'une horde (minutes) ; au-dela elle se termine comme a l'aube
		"maxWaveMinutes": 20
	},

	// Difficulte D = base + perNight * nuit + perLevel * (niveau - 1) + perExtraPlayer * (membres presents - 1),
	// bornee a [base, max]. 'nuit' = palier de la guilde (+1 par victoire, recule apres une defaite).
	"difficulty": {

		// Difficulte de base (minimum)
		"base": 1.0,

		// Difficulte ajoutee par palier de nuit
		"perNight": 0.5,

		// Difficulte ajoutee par niveau de guilde au-dela du niveau 1
		"perLevel": 0.5,

		// Difficulte ajoutee par membre present supplementaire (au demarrage)
		"perExtraPlayer": 0.75,

		// Difficulte maximale
		"max": 20.0,

		// Nombre de monstres = arrondi(mobsBase + mobsPerDifficulty * D) borne a [minMobs, maxMobsPerWave]
		"mobsBase": 6.0,
		"mobsPerDifficulty": 3.0,
		"minMobs": 5,
		"maxMobsPerWave": 80,

		// Chance qu'un monstre soit une elite = min(eliteMax, eliteBase + elitePerDifficulty * D) (+ bonus du theme)
		"eliteBase": 0.02,
		"elitePerDifficulty": 0.015,
		"eliteMax": 0.35,

		// Nuits de boss : a partir du palier bossMinNight, puis tous les bossEveryNights paliers (0 = jamais)
		"bossMinNight": 5,
		"bossEveryNights": 5
	},

	// Apparition des monstres (par groupes, en bordure du territoire)
	"spawning": {

		// Intervalle entre deux groupes de monstres (secondes)
		"spawnGroupIntervalSeconds": 12,

		// Delai avant le premier groupe (secondes)
		"firstGroupDelaySeconds": 6,

		// Duree visee pour faire apparaitre toute la horde (secondes) : determine la taille des groupes
		"spawnPhaseSeconds": 240,

		// Taille minimale / maximale d'un groupe
		"groupSizeMin": 2,
		"groupSizeMax": 8,

		// Nombre maximum de monstres de horde vivants par base
		"maxAliveMobsPerBase": 30,

		// Nombre maximum de monstres de horde vivants sur tout le serveur
		"globalMaxAliveMobs": 150,

		// Essais de placement par base et par seconde (au-dela : nouvel essai la seconde suivante)
		"spawnAttemptsPerSecond": 16,

		// Distance minimale (blocs) entre un point d'apparition et un joueur
		"minPlayerDistance": 12,

		// Distance minimale (blocs) entre un point d'apparition et le coeur
		"minHeartDistance": 10,

		// Decalage du point d'apparition par rapport au bord du territoire, en blocs : 1 = premier bloc a l'exterieur.
		// Avec un minimum >= 1, les monstres apparaissent toujours dehors, jamais sur les remparts construits au bord.
		// 0 ou negatif = peut apparaitre a l'interieur du territoire.
		"edgeOffsetMin": 1,
		"edgeOffsetMax": 6,

		// Si la zone n'est pas chargee/active, le point est rapproche du coeur par pas de N blocs
		"walkStep": 8,

		// Dispersion (blocs) des monstres d'un meme groupe autour du point d'apparition
		"groupSpread": 4,

		// Le boss apparait quand cette fraction de la horde est deja apparue (0 = au debut, 1 = a la fin)
		"bossSpawnProgress": 0.4,

		// Particules et sons a l'apparition
		"spawnEffects": true
	},

	// Renforcement et comportement des monstres de la horde
	"mobs": {

		// Multiplicateur de vie = min(maxHealthMultiplier, 1 + healthPerDifficulty * (D - base))
		"healthPerDifficulty": 0.08,
		"maxHealthMultiplier": 3.0,

		// Multiplicateur de degats = min(maxDamageMultiplier, 1 + damagePerDifficulty * (D - base))
		"damagePerDifficulty": 0.05,
		"maxDamageMultiplier": 2.5,

		// Distance de poursuite minimale des monstres (blocs)
		"followRange": 48.0,

		// Les monstres sans cible attaquent le joueur le plus proche DANS le territoire a moins de N blocs
		"targetRange": 16.0,

		// Portee d'agression des monstres 'alwaysHostile' (endermen...), dans ou hors du territoire
		"aggroRange": 24.0,

		// Intervalle de pilotage de chaque monstre (secondes) : cible, chemin vers le coeur, blocage
		"steeringIntervalSeconds": 2,

		// Distance des etapes intermediaires vers le coeur (blocs)
		"waypointDistance": 24,

		// Un monstre sans cible immobile (< 1 bloc) pendant ce temps est retire puis reapparait (secondes)
		"stuckTimeoutSeconds": 30,

		// Un monstre introuvable (zone dechargee) pendant ce temps est remplace (secondes)
		"lostTimeoutSeconds": 15,

		// Chance par piece d'armure = min(armorChanceMax, armorChancePerDifficulty * D) (monstres 'gear')
		"armorChancePerDifficulty": 0.04,
		"armorChanceMax": 0.6,

		// Chance d'arme (main vide) = min(weaponChanceMax, weaponChancePerDifficulty * D)
		"weaponChancePerDifficulty": 0.05,
		"weaponChanceMax": 0.7,

		// Chance d'equipement ajoutee pour les elites et les boss
		"eliteGearBonus": 0.3,

		// Materiaux d'armure selon la difficulte (le plus haut atteint ; 'material' + _helmet/_chestplate/_leggings/_boots)
		"armorTiers": [
			{
				"minDifficulty": 0.0,
				"material": "minecraft:leather"
			},
			{
				"minDifficulty": 4.0,
				"material": "minecraft:chainmail"
			},
			{
				"minDifficulty": 8.0,
				"material": "minecraft:iron"
			},
			{
				"minDifficulty": 14.0,
				"material": "minecraft:diamond"
			}
		],

		// Armes selon la difficulte ('material' + _sword)
		"weaponTiers": [
			{
				"minDifficulty": 0.0,
				"material": "minecraft:wooden"
			},
			{
				"minDifficulty": 3.0,
				"material": "minecraft:stone"
			},
			{
				"minDifficulty": 8.0,
				"material": "minecraft:iron"
			},
			{
				"minDifficulty": 15.0,
				"material": "minecraft:diamond"
			}
		],

		// Elites : multiplicateurs supplementaires de vie et de degats, contour lumineux
		"eliteHealthMultiplier": 2.0,
		"eliteDamageMultiplier": 1.5,
		"eliteGlowing": true,

		// Boss : taille (attribut scale), resistance au recul, contour lumineux
		"bossScale": 1.3,
		"bossKnockbackResistance": 0.6,
		"bossGlowing": true
	},

	// Coeur de la base : points d'integrite et degats subis chaque seconde
	"heart": {

		// Integrite du coeur = baseIntegrity + integrityPerLevel * (niveau - 1)
		"baseIntegrity": 150,
		"integrityPerLevel": 30,

		// Les monstres a moins de 'radius' blocs (horizontalement) et 'verticalRange' blocs (verticalement) du coeur l'endommagent
		"radius": 3.0,
		"verticalRange": 4.0,

		// Degats par seconde : monstre normal, elite, boss
		"damageNormal": 1,
		"damageElite": 3,
		"damageBoss": 8,

		// Alerte (barre d'action) aux membres quand le coeur est attaque, au plus toutes les N secondes
		"alertIntervalSeconds": 5
	},

	// Recompenses de victoire, multipliees par un facteur selon la proportion de monstres tues :
	// facteur = minRewardFactor + (1 - minRewardFactor) * (tues / total)
	"rewards": {

		// Or verse au tresor = arrondi((goldBase + goldPerDifficulty * D) * facteur)
		"goldBase": 4.0,
		"goldPerDifficulty": 2.0,

		// XP de guilde = arrondi((xpBase + xpPerDifficulty * D) * facteur)
		"xpBase": 20.0,
		"xpPerDifficulty": 10.0,

		// Facteur de recompense si aucun monstre n'a ete tue (1.0 si tous l'ont ete)
		"minRewardFactor": 0.25,

		// Tirages d'objets pour chaque membre present pendant la horde =
		// min(itemRollsMax, arrondi((itemRollsBase + itemRollsPerDifficulty * D) * tues / total))
		"itemRollsBase": 1.0,
		"itemRollsPerDifficulty": 0.25,
		"itemRollsMax": 6,

		// Table d'objets (item, min, max, weight, minDifficulty)
		"items": [
			{
				"item": "minecraft:iron_ingot",
				"min": 2,
				"max": 6,
